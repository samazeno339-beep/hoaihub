local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

--============================================================--
-- GET CORE
--============================================================--

local Core = _G.HoaiLamScript

if not Core then
	warn("[Hoài Làm Script] Không tìm thấy Core!")
	return
end

local CONFIG = Core.Config
local State = Core.State

local Gui = Core.Gui
local Main = Core.Main
local Top = Core.Top

local Sidebar = Core.Sidebar
local Content = Core.Content

local Minimize = Core.Minimize
local Close = Core.Close

if not Gui or not Main or not Top then
	warn("[Hoài Làm Script] Part 1 chưa được chạy!")
	return
end

--============================================================--
-- TWEEN
--============================================================--

local function Tween(object, properties, duration)

	local tween = TweenService:Create(
		object,

		TweenInfo.new(
			duration or 0.2,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),

		properties
	)

	tween:Play()

	return tween
end

--============================================================--
-- FLOATING LOGO
--============================================================--

local OpenButton =
	Instance.new("ImageButton")

OpenButton.Name =
	"FloatingLogo"

OpenButton.Size =
