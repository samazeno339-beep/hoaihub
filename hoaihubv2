--============================================================--
-- FLOATING LOGO HOVER
--============================================================--

OpenButton.MouseEnter:Connect(function()

	Tween(
		OpenButton,
		{
			Size =
				UDim2.fromOffset(
					63,
					63
				)
		},
		0.12
	)

end)

OpenButton.MouseLeave:Connect(function()

	Tween(
		OpenButton,
		{
			Size =
				UDim2.fromOffset(
					58,
					58
				)
		},
		0.12
	)

end)

--============================================================--
-- FLOATING LOGO DRAG
--============================================================--

local floatingDragging = false

local floatingStart
local floatingStartPos

OpenButton.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		floatingDragging = true

		floatingStart =
			input.Position

		floatingStartPos =
			OpenButton.Position

		input.Changed:Connect(function()

			if input.UserInputState ==
				Enum.UserInputState.End then

				floatingDragging =
					false

			end

		end)

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if not floatingDragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		local delta =
			input.Position -
			floatingStart

		OpenButton.Position =
			UDim2.new(
				floatingStartPos.X.Scale,
				floatingStartPos.X.Offset + delta.X,

				floatingStartPos.Y.Scale,
				floatingStartPos.Y.Offset + delta.Y
			)

	end

end)

--============================================================--
-- SHOW UI
--============================================================--

local function ShowUI()

	State.UIVisible =
		true

	Main.Visible =
		true

	OpenButton.Visible =
		false

	Main.Size =
		UDim2.fromOffset(
			0,
			0
		)

	Tween(
		Main,
		{
			Size =
				UDim2.fromOffset(
					CONFIG.Width,

					State.Minimized
						and 64
						or CONFIG.Height
				)
		},
		0.25
	)

end

--============================================================--
-- HIDE UI
--============================================================--

local function HideUI()

	State.UIVisible =
		false

	Tween(
		Main,
		{
			Size =
				UDim2.fromOffset(
					0,
					0
				)
		},
		0.2
	)

	task.delay(
		0.2,
		function()

			if not State.UIVisible then

				Main.Visible =
					false

				OpenButton.Visible =
					true

			end

		end
	)

end

--============================================================--
-- TOGGLE UI
--============================================================--

local function ToggleUI()

	if State.UIVisible then
		HideUI()
	else
		ShowUI()
	end

end

--============================================================--
-- FLOATING BUTTON CLICK
--============================================================--

OpenButton.Activated:Connect(function()

	ToggleUI()

end)

--============================================================--
-- MAIN WINDOW DRAG
--============================================================--

local dragging = false

local dragStart
local startPosition

Top.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		dragging =
			true

		dragStart =
			input.Position

		startPosition =
			Main.Position

		input.Changed:Connect(function()

			if input.UserInputState ==
				Enum.UserInputState.End then

				dragging =
					false

			end

		end)

	end

end)

UserInputService.InputChanged:Connect(function(input)

	if not dragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement

		or input.UserInputType ==
		Enum.UserInputType.Touch then

		local delta =
			input.Position -
			dragStart

		Main.Position =
			UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,

				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)

	end

end)

--============================================================--
-- MINIMIZE
--============================================================--

Minimize.Activated:Connect(function()

	State.Minimized =
		not State.Minimized

	if State.Minimized then

		Sidebar.Visible =
			false

		Content.Visible =
			false

		Tween(
			Main,
			{
				Size =
					UDim2.fromOffset(
						CONFIG.Width,
						64
					)
			},
			0.25
		)

	else

		Tween(
			Main,
			{
				Size =
					UDim2.fromOffset(
						CONFIG.Width,
						CONFIG.Height
					)
			},
			0.25
		)

		task.delay(
			0.15,
			function()

				if not State.Minimized then

					Sidebar.Visible =
						true

					Content.Visible =
						true

				end

			end
		)

	end

end)

--============================================================--
-- CLOSE
--============================================================--

Close.Activated:Connect(function()

	State.UIVisible =
		false

	Tween(
		Main,
		{
			Size =
				UDim2.fromOffset(
					0,
					0
				)
		},
		0.2
	)

	task.delay(
		0.22,
		function()

			if Gui then
				Gui:Destroy()
			end

			_G.HoaiLamScript =
				nil

		end
	)

end)

--============================================================--
-- RIGHT CONTROL SHOW / HIDE
--============================================================--

UserInputService.InputBegan:Connect(
	function(input, processed)

		if processed then
			return
		end

		if input.KeyCode ==
			CONFIG.ToggleKey then

			ToggleUI()

		end

	end
)

