--============================================================--
-- TOGGLE SYSTEM
--============================================================--

local ToggleCallbacks = {}

local function CreateToggle(
	parent,
	name,
	stateKey,
	default
)

	State[stateKey] =
		default or false

	local button =
		Instance.new("TextButton")

	button.Name =
		name

	button.Size =
		UDim2.new(
			1,
			-5,
			0,
			48
		)

	button.BackgroundColor3 =
		CONFIG.Panel2

	button.BorderSizePixel =
		0

	button.Text = ""

	button.Parent =
		parent

	CreateCorner(
		button,
		10
	)

	local label =
		Instance.new("TextLabel")

	label.BackgroundTransparency =
		1

	label.Position =
		UDim2.fromOffset(
			15,
			0
		)

	label.Size =
		UDim2.new(
			1,
			-90,
			1,
			0
		)

	label.Text =
		name

	label.TextColor3 =
		CONFIG.Text

	label.TextSize =
		13

	label.Font =
		Enum.Font.GothamMedium

	label.TextXAlignment =
		Enum.TextXAlignment.Left

	label.Parent =
		button

	local status =
		Instance.new("TextLabel")

	status.BackgroundTransparency =
		1

	status.Position =
		UDim2.new(
			1,
			-70,
			0,
			0
		)

	status.Size =
		UDim2.fromOffset(
			55,
			48
		)

	status.TextSize =
		11

	status.Font =
		Enum.Font.GothamBold

	status.Parent =
		button

	local function Update()

		local enabled =
			State[stateKey]

		status.Text =
			enabled
			and "ON"
			or "OFF"

		status.TextColor3 =
			enabled
			and CONFIG.PurpleLight
			or CONFIG.SubText

		button.BackgroundColor3 =
			enabled
			and Color3.fromRGB(
				42,
				25,
				61
			)
			or CONFIG.Panel2
	end

	button.Activated:Connect(function()

		State[stateKey] =
			not State[stateKey]

		Update()

		local callback =
			ToggleCallbacks[stateKey]

		if callback then
			task.spawn(
				callback,
				State[stateKey]
			)
		end
	end)

	Update()

	return button
end

local function BindToggle(
	stateKey,
	callback
)

	ToggleCallbacks[stateKey] =
		callback

end

