-- 3) TÍNH NĂNG: FIX LAG (Xóa hiệu ứng rác, tăng tối đa FPS)
---------------------------------------------------------
CreateButton("FixLag_Trigger", "3) Kích Hoạt Fix Lag", function()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("VisualEffect") or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            obj:Destroy()
        elseif obj:IsA("Texture") or obj:IsA("Decal") then
            obj:Destroy()
        end
    end
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    ContentScroll.FixLag_Trigger.Text = "3) Đã Tối Ưu FPS ✓"
    ContentScroll.FixLag_Trigger.TextColor3 = Color3.fromRGB(0, 255, 255)
end)

---------------------------------------------------------
-- 4) TÍNH NĂNG: FLY (Bay tự do với nút Q bay lên / E hạ xuống)
---------------------------------------------------------
local bodyVelocity, bodyGyro
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if States.Fly and char and char:FindFirstChild("HumanoidRootPart") then
        if not bodyVelocity or bodyVelocity.Parent ~= char.HumanoidRootPart then
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bodyVelocity.Parent = char.HumanoidRootPart
            
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            bodyGyro.Parent = char.HumanoidRootPart
        end
        
        bodyGyro.CFrame = Camera.CFrame
        local moveDirection = Vector3.new(0, 0, 0)
        
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0) -- Nút Q lên
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0) -- Nút E xuống
        end
        
        bodyVelocity.Velocity = moveDirection * States.FlySpeed
    else
        if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    end
end)

CreateButton("Fly_Toggle", "4) Fly (Q: Lên / E: Xuống): OFF", function()
