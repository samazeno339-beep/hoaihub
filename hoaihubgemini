local function Toggle(parent, title, callback)

    local Button = New("TextButton", {
        Parent = parent,

        Size = UDim2.new(1, -5, 0, 45),

        BackgroundColor3 = CONFIG.Card,
        BorderSizePixel = 0,

        Text = "",

        AutoButtonColor = false
    })

    Corner(Button, 10)

    New("TextLabel", {
        Parent = Button,

        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -75, 1, 0),

        BackgroundTransparency = 1,

        Text = title,
        TextColor3 = CONFIG.Text,

        Font = Enum.Font.GothamMedium,
        TextSize = 12,

        TextXAlignment = Enum.TextXAlignment.Left
    })

    local Switch = New("Frame", {
        Parent = Button,

        Size = UDim2.fromOffset(42, 22),
        Position = UDim2.new(1, -55, 0.5, -11),

        BackgroundColor3 = Color3.fromRGB(55, 45, 65),
        BorderSizePixel = 0
    })

    Corner(Switch, 20)

    local Circle = New("Frame", {
        Parent = Switch,

        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.fromOffset(3, 3),

        BackgroundColor3 = Color3.fromRGB(210, 205, 215),
        BorderSizePixel = 0
    })

    Corner(Circle, 20)

    local Enabled = false

    Button.MouseButton1Click:Connect(function()

        Enabled = not Enabled

        if Enabled then

            Tween(
                Switch,
                TweenInfo.new(0.2),
                {
                    BackgroundColor3 = CONFIG.Purple
                }
            ):Play()

            Tween(
                Circle,
                TweenInfo.new(0.2),
                {
                    Position = UDim2.fromOffset(23, 3)
                }
            ):Play()

        else

            Tween(
                Switch,
                TweenInfo.new(0.2),
                {
                    BackgroundColor3 =
                        Color3.fromRGB(55, 45, 65)
                }
            ):Play()

            Tween(
                Circle,
                TweenInfo.new(0.2),
                {
                    Position = UDim2.fromOffset(3, 3)
                }
            ):Play()

        end

        if callback then
            callback(Enabled)
        end

    end)

    return Button
end

--========================================================--
-- SLIDER
--========================================================--

local function Slider(
    parent,
    title,
    min,
    max,
    default,
    callback
)

    local Frame = New("Frame", {
        Parent = parent,

        Size = UDim2.new(1, -5, 0, 65),

        BackgroundColor3 = CONFIG.Card,
        BorderSizePixel = 0
    })

    Corner(Frame, 10)

    New("TextLabel", {
        Parent = Frame,

        Position = UDim2.fromOffset(14, 8),
        Size = UDim2.new(1, -80, 0, 20),

        BackgroundTransparency = 1,

        Text = title,
        TextColor3 = CONFIG.Text,

        Font = Enum.Font.GothamMedium,
        TextSize = 12,

        TextXAlignment = Enum.TextXAlignment.Left
    })

    local Value = New("TextLabel", {
        Parent = Frame,

        Position = UDim2.new(1, -60, 0, 8),
        Size = UDim2.fromOffset(45, 20),

        BackgroundTransparency = 1,

        Text = tostring(default),
        TextColor3 = CONFIG.Purple,

        Font = Enum.Font.GothamBold,
        TextSize = 11,

        TextXAlignment = Enum.TextXAlignment.Right
    })

    local Bar = New("Frame", {
        Parent = Frame,

        Position = UDim2.fromOffset(14, 38),
        Size = UDim2.new(1, -28, 0, 6),

        BackgroundColor3 = Color3.fromRGB(55, 45, 65),
        BorderSizePixel = 0
    })

    Corner(Bar, 10)

    local Fill = New("Frame", {
        Parent = Bar,

        Size = UDim2.new(
            (default - min) / (max - min),
            0,
            1,
            0
        ),

        BackgroundColor3 = CONFIG.Purple,
        BorderSizePixel = 0
    })

    Corner(Fill, 10)

    local Dragging = false

    local function Update(input)

        local percent = math.clamp(
            (
                input.Position.X -
                Bar.AbsolutePosition.X
            ) / Bar.AbsoluteSize.X,

            0,
            1
        )

        local value = math.floor(
            min + (max - min) * percent
        )

        Fill.Size = UDim2.new(
            percent,
            0,
            1,
            0
        )

        Value.Text = tostring(value)

        if callback then
            callback(value)
        end

    end

    Bar.InputBegan:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            Dragging = true
            Update(input)

        end

    end)

    UserInputService.InputChanged:Connect(function(input)

        if Dragging and (
            input.UserInputType ==
                Enum.UserInputType.MouseMovement

            or input.UserInputType ==
                Enum.UserInputType.Touch
        ) then

            Update(input)

        end

    end)

    UserInputService.InputEnded:Connect(function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1

            or input.UserInputType ==
            Enum.UserInputType.Touch then

            Dragging = false

        end

    end)

    return Frame
end

