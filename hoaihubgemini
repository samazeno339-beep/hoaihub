local function CreateButton(name, text, callback)

    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = ContentScroll

    btn.Size = UDim2.new(1, -10, 0, 38)

    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.BorderSizePixel = 0

    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.SourceSansSemibold

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        callback(btn)
    end)

    return btn
end

--========================================================--
-- ESP
--========================================================--

local function ApplyESP(player)

    if player == LocalPlayer then
        return
    end

    local function ApplyCharacter(character)

        if character:FindFirstChild("HoaiHubESP") then
            return
        end

        local highlight = Instance.new("Highlight")

        highlight.Name = "HoaiHubESP"
        highlight.Adornee = character
        highlight.Parent = character

        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.FillTransparency = 0.5

        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
    end

    if player.Character then
        ApplyCharacter(player.Character)
    end

    player.CharacterAdded:Connect(function(character)

        if States.ESP then
            ApplyCharacter(character)
        end

    end)
end

local function RemoveESP()

    for _, player in ipairs(Players:GetPlayers()) do

        if player.Character then

            local esp = player.Character:FindFirstChild("HoaiHubESP")

            if esp then
                esp:Destroy()
            end

        end
    end
end

