local function title(page, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -4, 0, 28)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = page
end

local function toggle(page, text, key)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -4, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.Parent = page

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)

    local function update()
        button.Text = text .. (Settings[key] and " [ON]" or " [OFF]")
        button.BackgroundColor3 =
            Settings[key]
            and Color3.fromRGB(80, 45, 130)
            or Color3.fromRGB(30, 30, 38)
    end

    button.Activated:Connect(function()
        Settings[key] = not Settings[key]
        update()
    end)

    update()
end

local function numberBox(page, placeholder, value, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -4, 0, 36)
    box.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.PlaceholderText = placeholder
    box.Text = tostring(value)
    box.TextSize = 11
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.Parent = page

    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)

    box.FocusLost:Connect(function()
        local valueNumber = tonumber(box.Text)
        if valueNumber then
            callback(valueNumber)
        end
    end)
end

