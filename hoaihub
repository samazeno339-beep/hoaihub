--==================================================
-- CHARACTER
--==================================================

local Character
local Humanoid
local Root


local function LoadCharacter()

	Character = Player.Character or Player.CharacterAdded:Wait()

	Humanoid =
	Character:WaitForChild("Humanoid")

	Root =
	Character:WaitForChild("HumanoidRootPart")

end


LoadCharacter()


Player.CharacterAdded:Connect(function()

	task.wait(1)

	LoadCharacter()

end)



