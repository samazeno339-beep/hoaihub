local function MakeToggle(parent, label, defaultValue, callback)
	local button = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = defaultValue and CONFIG.Colors.Accent or CONFIG.Colors.Button,
		Text = label .. " : " .. (defaultValue and "ON" or "OFF"),
