--========================================================--

local function ApplyUIScale(percent)

    percent = math.clamp(
        math.floor(percent + 0.5),
        50,
        150
    )

    State.UIScalePercent = percent

    UIScaleObject.Scale = percent / 100

    ScaleValue.Text =
        "UI Scale: " .. tostring(percent) .. "%"

    -- 50% = 0
    -- 100% = 0.5
    -- 150% = 1

    local alpha =
        (percent - 50) / 100

    ScaleFill.Size =
        UDim2.fromScale(alpha, 1)

    ScaleKnob.Position =
        UDim2.new(
            alpha,
            -11,
            0.5,
            -11
        )
end

--========================================================--
-- SLIDER POSITION
--========================================================--

local function SetScaleFromX(x)

    local barPosition =
        ScaleBar.AbsolutePosition.X

    local barWidth =
        ScaleBar.AbsoluteSize.X

    if barWidth <= 0 then
        return
    end

    local alpha =
        math.clamp(
            (x - barPosition) / barWidth,
            0,
            1
        )

    local percent =
        50 + alpha * 100

    ApplyUIScale(percent)
end

