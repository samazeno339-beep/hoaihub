RunService.Heartbeat:Connect(function()
    local hum = humanoid()

    if hum then
        hum.WalkSpeed =
            Settings.Speed and Settings.SpeedValue or 16

        hum.UseJumpPower = true
        hum.JumpPower =
            Settings.Jump and Settings.JumpValue or 50
    end

    if Settings.NoClip then
        local c = character()

        if c then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end

    if Settings.ESP then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") then
                addESP(obj)
            end
        end

        local myRoot = root()

        for model, data in pairs(espObjects) do
            if not model.Parent then
                if data.highlight then data.highlight:Destroy() end
                if data.billboard then data.billboard:Destroy() end
                espObjects[model] = nil
            else
                local part =
                    model:FindFirstChild("Head")
                    or model:FindFirstChild("HumanoidRootPart")

                if part then
                    local text = model.Name

                    if myRoot then
                        local distance =
                            (myRoot.Position - part.Position).Magnitude

                        text =
                            model.Name ..
                            " [" ..
                            math.floor(distance) ..
                            "m]"
                    end

                    data.text.Text = text
                end
            end
        end
    elseif next(espObjects) then
        clearESP()
    end

    if Settings.RemoveEffects then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter")
                or obj:IsA("Trail")
                or obj:IsA("Beam")
                or obj:IsA("Smoke")
                or obj:IsA("Fire")
                or obj:IsA("Sparkles") then
                obj.Enabled = false
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera

    if Settings.Aim and camera then
        local target = nearestTarget()

        if target then
            local wanted =
                CFrame.lookAt(
                    camera.CFrame.Position,
                    target.Position
                )

            camera.CFrame =
                camera.CFrame:Lerp(
                    wanted,
                    Settings.AimSmooth
                )
        end
    end

    if not Settings.Fly then
        FlyUp.Visible = false
        FlyDown.Visible = false

        if flyVelocity then
            flyVelocity:Destroy()
            flyVelocity = nil
        end

        if flyGyro then
            flyGyro:Destroy()
            flyGyro = nil
        end

        local hum = humanoid()

        if hum then
            hum.PlatformStand = false
            hum.AutoRotate = true
        end

        return
    end

    FlyUp.Visible = true
    FlyDown.Visible = true

    local myRoot = root()
    local hum = humanoid()

    if not myRoot or not hum then return end

    if not flyVelocity then
        flyVelocity = Instance.new("BodyVelocity")
        flyVelocity.MaxForce =
            Vector3.new(math.huge, math.huge, math.huge)
        flyVelocity.P = 12500
        flyVelocity.Parent = myRoot
    end

    if not flyGyro then
        flyGyro = Instance.new("BodyGyro")
        flyGyro.MaxTorque =
            Vector3.new(math.huge, math.huge, math.huge)
        flyGyro.P = 20000
        flyGyro.Parent = myRoot
    end

    hum.PlatformStand = true
    hum.AutoRotate = false

    local camera = workspace.CurrentCamera
    local direction = hum.MoveDirection * Settings.FlySpeed

    if camera then
        local look = camera.CFrame.LookVector

        flyGyro.CFrame =
            CFrame.lookAt(
                myRoot.Position,
                myRoot.Position + look
            )
    end

    local vertical = 0

    if flyUp then
       vertical += Settings.FlySpeed
    end

    if flyDown then
        vertical -= Settings.FlySpeed
    end

    flyVelocity.Velocity =
        Vector3.new(
            direction.X,
            vertical,
            direction.Z
        )
end)

--==================================================
-- DRAG UI
