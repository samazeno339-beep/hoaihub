	lv.MaxForce = math.huge
	lv.VectorVelocity = Vector3.zero
	lv.Parent = root
	TravelController.LinearVelocity = lv

	local ao = Instance.new("AlignOrientation")
	ao.Name = "HoaiTravelAlignOrientation"
	ao.Attachment0 = att
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.MaxTorque = math.huge
	ao.Responsiveness = 18
	ao.RigidityEnabled = false
	ao.Parent = root
	TravelController.AlignOrientation = ao

	TravelController.Connection = RunService.Heartbeat:Connect(function(dt)
		if not State.Traveling then
			StopTravel()
			return
		end

		local root2 = GetRoot(GetCharacter())
		local tRoot = targetPlayer.Character and GetRoot(targetPlayer.Character)
		if not root2 or not tRoot then
			StopTravel()
			return
		end

		local delta = tRoot.Position - root2.Position
		local distance = delta.Magnitude

		if distance <= 3 then
			StopTravel()
			return
		end

		local direction = delta.Unit
		lv.VectorVelocity = lv.VectorVelocity:Lerp(
			direction * Clamp(State.TPSpeed, 1, 1000),
			Clamp(dt * 10, 0, 1)
		)
		ao.CFrame = CFrame.lookAt(Vector3.zero, direction)
	end)
end

