local Player = Players.LocalPlayer
local Camera = workspace.CurrentCamera


--==================================================
-- CONFIG
--==================================================

local DebugConfig = {

	TrainingEnabled = false,

	ShowBox = false,

	ShowLine = false,

	Range = 100,

	TargetFolder = "TrainingTargets"

}



--==================================================
-- FIND TRAINING TARGET
--==================================================

local function GetTargets()

	local Folder =
	workspace:FindFirstChild(
		DebugConfig.TargetFolder
	)


	if not Folder then
		return {}
	end


	return Folder:GetChildren()

end



local function GetNearestTarget()

	local Closest = nil
	local Distance = math.huge


	local Character =
	Player.Character


	if not Character then
		return nil
	end


	local Root =
	Character:FindFirstChild(
		"HumanoidRootPart"
	)


	if not Root then
		return nil
	end



	for _,Target in pairs(GetTargets()) do


		local TargetRoot =
		Target:FindFirstChild(
			"HumanoidRootPart"
		)


		if TargetRoot then


			local Dist =
			(Root.Position -
			TargetRoot.Position).Magnitude



			if Dist < Distance
			and Dist <= DebugConfig.Range then


				Distance = Dist

				Closest = Target


			end

		end


	end


	return Closest

end



--==================================================
-- DEBUG BOX
--==================================================

local function CreateMarker(Target)


	if Target:FindFirstChild(
		"HoaiMarker"
	) then
		return
	end



	local Highlight =
	Instance.new("Highlight")


	Highlight.Name =
	"HoaiMarker"


	Highlight.FillTransparency =
	0.5


	Highlight.OutlineTransparency =
	0


	Highlight.Parent =
	Target



end



local function RemoveMarker(Target)


	local Marker =
	Target:FindFirstChild(
		"HoaiMarker"
	)


	if Marker then

		Marker:Destroy()

	end


end



--==================================================
-- DEBUG UPDATE
--==================================================

RunService.RenderStepped:Connect(function()


	for _,Target in pairs(GetTargets()) do


		if DebugConfig.ShowBox then

			CreateMarker(Target)

		else

			RemoveMarker(Target)

		end


	end


end)



--==================================================
-- TRAINING TARGET TOGGLE
--==================================================

function ToggleTraining(Value)

	DebugConfig.TrainingEnabled =
	Value

end



function SetRange(Value)

	DebugConfig.Range =
	math.clamp(
		Value,
	10,
	500
	)

end



function ToggleBox(Value)

	DebugConfig.ShowBox =
	Value

end



