local function UpdateAimLine(fromPos, toPos)
	local delta = toPos - fromPos
	AimLine.Position = UDim2.fromOffset((fromPos.X + toPos.X) / 2, (fromPos.Y + toPos.Y) / 2)
	AimLine.Size = UDim2.fromOffset(delta.Magnitude, 3)
	AimLine.Rotation = math.deg(math.atan2(delta.Y, delta.X))
end

RunService.RenderStepped:Connect(function()
	local camera = GetCamera()
	if not camera then return end

	FOVCircle.Size = UDim2.fromOffset(State.AimFOV, State.AimFOV)
	FOVCircle.Visible = State.AimEnabled
	AimLine.Visible = false

	if not State.AimEnabled or not State.UniversalTargeting then
		State.CurrentTarget = nil
		return
	end

	local targetModel, targetPart = SelectBestTarget()
	State.CurrentTarget = targetModel

	if not targetPart then return end

	local screenPos, visible = camera:WorldToViewportPoint(targetPart.Position)
	if visible and screenPos.Z > 0 then
		UpdateAimLine(camera.ViewportSize / 2, Vector2.new(screenPos.X, screenPos.Y))
		AimLine.Visible = true
	end

	camera.CFrame = camera.CFrame:Lerp(
		CFrame.lookAt(camera.CFrame.Position, targetPart.Position),
		Clamp(State.AimSmoothness, 0.01, 1)
	)
end)

local ESPByModel = {}
local NPCCache = {}

local function DestroyESP(model)
	local data = ESPByModel[model]
	if not data then return end
	if data.Billboard then data.Billboard:Destroy() end
	if data.Highlight then data.Highlight:Destroy() end
	ESPByModel[model] = nil
end

local function CreateESP(model, player, isNPC)
	if not model or ESPByModel[model] or not GetRoot(model) then return end

	local hl = Instance.new("Highlight")
	hl.Name = "HoaiESPHighlight"
	hl.Adornee = model
	hl.FillTransparency = 0.78
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Enabled = State.ShowHighlight
	hl.FillColor = isNPC and Color3.fromRGB(255, 170, 70) or Color3.fromRGB(80, 150, 255)
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.Parent = ESPGui

	local bb = Instance.new("BillboardGui")
	bb.Name = "HoaiESPBillboard"
	bb.Size = UDim2.fromOffset(220, 72)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 1500
	bb.Adornee = GetRoot(model)
	bb.Parent = ESPGui

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = isNPC and Color3.fromRGB(255, 190, 90) or Color3.fromRGB(120, 190, 255)
	label.TextStrokeTransparency = 0.25
	label.TextSize = 12
	label.Font = Enum.Font.GothamBold
	label.TextWrapped = true
	label.Parent = bb

	ESPByModel[model] = {
		Billboard = bb,
		Highlight = hl,
		Text = label,
		IsNPC = isNPC,
		Player = player,
	}
end

local function RefreshNPCCache()
	NPCCache = GetAllNPCModels()
end

local function RefreshESP()
	for model in pairs(ESPByModel) do
		local isPlayer = Players:GetPlayerFromCharacter(model) ~= nil
		local keep = model.Parent and (
			(isPlayer and State.PlayerESP) or
			((not isPlayer) and State.NPCESP)
		)
		if not keep then DestroyESP(model) end
	end

	if State.PlayerESP then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character and IsAlive(plr.Character) and IsEnemyPlayer(plr) then
				CreateESP(plr.Character, plr, false)
			end
		end
	end

	if State.NPCESP then
		for _, npc in ipairs(NPCCache) do
			if npc.Parent and IsAlive(npc) and not Players:GetPlayerFromCharacter(npc) then
				CreateESP(npc, nil, true)
			end
		end
	end

	for model, data in pairs(ESPByModel) do
		if not model.Parent then
			DestroyESP(model)
		elseif data.Text then
			data.Text.Text = UpdateESPText(model, data.Player)
			data.Highlight.Enabled = State.ShowHighlight
			data.Billboard.Adornee = GetRoot(model)
		end
	end
end

