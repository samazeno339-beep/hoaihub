local function GetTargetPart(player)
    if player == LocalPlayer then
        return nil
    end

    local character = player.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")

    if humanoid and humanoid.Health <= 0 then
        return nil
    end

    return head or root
end

local function PassesTeamCheck(player)
    if not State.AimTeamCheck then
        return true
    end

    if not player.Team or not LocalPlayer.Team then
        return true
    end

    return player.Team ~= LocalPlayer.Team
end

local function PassesWallCheck(targetPart)
    if not State.AimWallCheck then
        return true
    end

    local camera = workspace.CurrentCamera
    if not camera or not targetPart or not targetPart.Parent then
        return false
    end

    local origin = camera.CFrame.Position
    local direction = targetPart.Position - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local ignore = {}

    if LocalPlayer.Character then
        table.insert(ignore, LocalPlayer.Character)
    end

    params.FilterDescendantsInstances = ignore

    local result = workspace:Raycast(origin, direction, params)

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(targetPart.Parent)
end

local function FindAimTarget()
    local camera = workspace.CurrentCamera
    if not camera then
        return nil
    end

    local center = camera.ViewportSize / 2
    local bestTarget
    local bestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        local targetPart = GetTargetPart(player)

        if targetPart and PassesTeamCheck(player) then
            local screenPosition, onScreen =
                camera:WorldToViewportPoint(targetPart.Position)

            if onScreen and screenPosition.Z > 0 then
                local distance = (
                    Vector2.new(screenPosition.X, screenPosition.Y) - center
                ).Magnitude

                if distance <= State.AimFOV / 2
                    and distance < bestDistance
                    and PassesWallCheck(targetPart) then

                    bestTarget = targetPart
                    bestDistance = distance
                end
            end
        end
    end

    return bestTarget
end

local function UpdateAimLine(fromPosition, toPosition)
    local delta = toPosition - fromPosition

    AimLine.Position = UDim2.fromOffset(
        (fromPosition.X + toPosition.X) / 2,
        (fromPosition.Y +toPosition.Y) / 2
    )

    AimLine.Size = UDim2.fromOffset(delta.Magnitude, 3)
    AimLine.Rotation = math.deg(math.atan2(delta.Y, delta.X))
end

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    FOVCircle.Size = UDim2.fromOffset(State.AimFOV, State.AimFOV)
    FOVCircle.Visible = State.AimEnabled
    AimLine.Visible = false

    if not State.AimEnabled then
        return
    end

    local target = FindAimTarget()

    if not target then
        return
    end

    local center = camera.ViewportSize / 2
    local screenPosition, visible =
        camera:WorldToViewportPoint(target.Position)

    if not visible or screenPosition.Z <= 0 then
        return
    end

    local targetScreen = Vector2.new(screenPosition.X, screenPosition.Y)

    UpdateAimLine(center, targetScreen)
    AimLine.Visible = true

    camera.CFrame = camera.CFrame:Lerp(
        CFrame.lookAt(camera.CFrame.Position, target.Position),
        math.clamp(State.AimSmoothness, 0.01, 1)
    )
end)

-- ESP
local ESPFolder = New("Folder", {
    Name = "HoaiESP",
}, ScreenGui)

local ESPCache = {}

local function ClearESP()
    for model, object in pairs(ESPCache) do
        if object then
            object:Destroy()
        end
        ESPCache[model] = nil
    end
end

local function FindRoot(model)
    return model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart")
end

local function GetLevel(model, player)
    if player then
        local leaderstats = player:FindFirstChild("leaderstats")

        if leaderstats then
            local level = leaderstats:FindFirstChild("Level")
            if level and level.Value ~= nil then
                return tostring(level.Value)
            end
        end
    end

    local levelAttribute = model:GetAttribute("Level")
    if levelAttribute ~= nil then
        return tostring(levelAttribute)
    end

    local levelObject = model:FindFirstChild("Level", true)
    if levelObject and levelObject:IsA("ValueBase") then
        return tostring(levelObject.Value)
    end

    return nil
end

local function AddESP(model, player)
    if not model or ESPCache[model] then
        return
    end

    local root = FindRoot(model)
    if not root then
        return
    end

    local billboard = New("BillboardGui", {
        Size = UDim2.fromOffset(190, 75),
        StudsOffset = Vector3.new(0, 3, 0),
        AlwaysOnTop = true,
        Adornee = root,
    }, ESPFolder)

    local label = New("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        TextColor3 = Color3.new(1, 1, 1),
        TextStrokeTransparency = 0.35,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextWrapped = true,
    }, billboard)

    ESPCache[model] = billboard

    local function Update()
        if not model.Parent or not billboard.Parent then
            return
        end

        local humanoid = model:FindFirstChildOfClass("Humanoid")
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and FindRoot(myCharacter)

        local distanceText = "Distance: ?"

        if myRoot and root.Parent then
            distanceText =
                "Distance: " ..
                math.floor((root.Position - myRoot.Position).Magnitude) ..
                "m"
        end

        local hpText = ""

        if humanoid then
            hpText =
                "HP: " ..
                math.floor(humanoid.Health) ..
                " / " ..
                math.floor(humanoid.MaxHealth)
        end

        local level = GetLevel(model, player)
        local levelText = level and ("Level: " .. level) or ""

        local nameText = player and player.Name or model.Name

        label.Text =
            nameText ..
            "\n" ..
            hpText ..
            (hpText ~= "" and "  |  " or "") ..
            distanceText ..
            (levelText ~= "" and "\n" .. levelText or "")
    end

    Update()

    task.spawn(function()
        while billboard.Parent and model.Parent do
            Update()
            task.wait(0.25)
        end
    end)
end

local function RefreshESP()
    ClearESP()

    if State.PlayerESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                AddESP(player.Character, player)
            end
        end
    end

    if State.NPCESP then
        for _, object in ipairs(workspace:GetDescendants()) do
            if object:IsA("Model")
                and not Players:GetPlayerFromCharacter(object)
                and object:FindFirstChildOfClass("Humanoid") then

                AddESP(object, nil)
            end
        end
    end
