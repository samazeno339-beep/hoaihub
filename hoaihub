local function CreateSlider(parent, title, minValue, maxValue, defaultValue, callback)
    local row = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 58),

        BackgroundColor3 = CONFIG.Colors.Button,
        BorderSizePixel = 0,

        ZIndex = 14
    }, parent)

    AddCorner(row, 8)

    Create("TextLabel", {
        Position = UDim2.fromOffset(10, 5),

        Size = UDim2.new(1, -80, 0, 20),

        BackgroundTransparency = 1,

        Text = title,

        TextColor3 = CONFIG.Colors.Text,
        TextSize = 12,

        Font = Enum.Font.GothamSemibold,

        TextXAlignment = Enum.TextXAlignment.Left,

        ZIndex = 15
    }, row)

    local valueLabel = Create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),

        Position = UDim2.new(1, -10, 0, 5),

        Size = UDim2.fromOffset(55, 20),

        BackgroundTransparency = 1,

        TextColor3 = CONFIG.Colors.SubText,
        TextSize = 12,

        Font = Enum.Font.Gotham,

        TextXAlignment = Enum.TextXAlignment.Right,

        ZIndex = 15
    }, row)

    local bar = Create("Frame", {
        Position = UDim2.fromOffset(10, 34),

        Size = UDim2.new(1, -20, 0, 8),

        BackgroundColor3 = CONFIG.Colors.Background,

        BorderSizePixel = 0,

        ZIndex = 15
    }, row)

    AddCorner(bar, 5)

    local fill = Create("Frame", {
        Size = UDim2.fromScale(0, 1),

        BackgroundColor3 = CONFIG.Colors.Accent,

        BorderSizePixel = 0,

        ZIndex = 16
    }, bar)

    AddCorner(fill, 5)

    local value = math.clamp(defaultValue, minValue, maxValue)
    local dragging = false

    local function SetValue(newValue)
        value = math.clamp(newValue, minValue, maxValue)

        local alpha =
            (value - minValue) /
            (maxValue - minValue)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        valueLabel.Text = tostring(math.floor(value))

        if callback then
            callback(value)
        end
    end

    local function SetFromX(x)
        if bar.AbsoluteSize.X <= 0 then
            return
        end

        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) /
            bar.AbsoluteSize.X,
            0,
            1
        )

        SetValue(
            minValue +
            (maxValue - minValue) * alpha
        )
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            SetFromX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            SetFromX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)

    SetValue(value)

    return {
        Set = SetValue,

        Get = function()
            return value
        end
    }
end

