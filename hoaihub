RunService.Heartbeat:Connect(function()
    if not Character or not Character.Parent then
        return
    end

    if not Humanoid or not RootPart then
        return
    end

    -- NoClip
    if State.NoClipEnabled then
        for _, object in ipairs(Character:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = false
            end
        end
    end

    -- Fly
    if State.FlyEnabled then
        if not FlyVelocity or FlyVelocity.Parent ~= RootPart then
            StartFly()
        end

        local camera = workspace.CurrentCamera

        if camera and FlyVelocity then
            local direction = Humanoid.MoveDirection

            local velocity = direction * State.FlySpeed

            local vertical = 0

            if upHeld or keyboardUp then
                vertical += State.FlySpeed
            end

            if downHeld or keyboardDown then
                vertical -= State.FlySpeed
            end

            velocity += Vector3.new(0, vertical, 0)

            FlyVelocity.Velocity = velocity
        end
    elseif FlyVelocity then
        StopFly()
    end
end)

