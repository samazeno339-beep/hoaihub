RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera

    if Camera then
        if State.FOV then
            Camera.FieldOfView = State.FOV
        end
    end

    if not State.AimEnabled then
        State.AimTarget = nil
        return
    end

    local target = FindBestTarget()

    State.AimTarget = target

    if not target then
        return
    end

    local character = target.Character

    local targetPart =
        character and
        (
            character:FindFirstChild("Head")
            or GetCharacterRoot(character)
        )

    if not targetPart then
        return
    end

    local cameraPosition =
        Camera.CFrame.Position

    local desired =
        CFrame.lookAt(
            cameraPosition,
            targetPart.Position
        )

    Camera.CFrame =
        Camera.CFrame:Lerp(
            desired,
            State.AimSmoothness
        )
end)

