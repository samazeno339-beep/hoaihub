local function ApplyUIScale(percent)
	percent = Clamp(math.floor(percent + 0.5), 50, 150)

	State.UIScalePercent = percent
	UIScale.Scale = percent / 100

	ScaleReadout.Text = "UI Scale: " .. percent .. "%"

	local alpha = (percent - 50) / 100
	ScaleFill.Size = UDim2.fromScale(alpha, 1)
	ScaleKnob.Position = UDim2.new(alpha, -11, 0.5, -11)
end

