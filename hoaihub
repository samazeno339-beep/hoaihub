local ThemeButton = Create("TextButton", {
    Size = UDim2.new(1, 0, 0, 40),
    BackgroundColor3 = CONFIG.Colors.Button,
    Text = "Theme: Dark",
    TextColor3 = CONFIG.Colors.Text,
    TextSize = 13,
    Font = Enum.Font.GothamSemibold,
    AutoButtonColor = false
}, SettingsPage)

AddCorner(ThemeButton, 8)

local function ApplyTheme(theme)
    State.Theme = theme

    local background
    local secondary
    local panel
    local button
    local accent

    if theme == "Dark" then
        background = Color3.fromRGB(15, 15, 20)
        secondary = Color3.fromRGB(22, 22, 30)
        panel = Color3.fromRGB(28, 28, 38)
        button = Color3.fromRGB(38, 38, 50)
        accent = Color3.fromRGB(90, 120, 255)
    else
        background = Color3.fromRGB(235, 235, 240)
        secondary = Color3.fromRGB(220, 220, 228)
        panel = Color3.fromRGB(245, 245, 248)
        button = Color3.fromRGB(205, 205, 215)
        accent = Color3.fromRGB(70, 100, 220)
    end

    MainWindow.BackgroundColor3 = background
    Header.BackgroundColor3 = secondary
    Sidebar.BackgroundColor3 = secondary
    Content.BackgroundColor3 = secondary
    Logo.BackgroundColor3 = accent

    for _, object in ipairs(
        Sidebar:GetDescendants()
    ) do
        if object:IsA("TextButton")
            and object ~= Close
            and object ~= Minimize then

            object.BackgroundColor3 = button
        end
    end

    ThemeButton.Text = "Theme: " .. theme
end

ThemeButton.MouseButton1Click:Connect(function()
    if State.Theme == "Dark" then
        ApplyTheme("Light")
    else
        ApplyTheme("Dark")
    end
end)

