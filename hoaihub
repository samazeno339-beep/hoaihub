local FlyVelocity
local FlyGyro

local function StopFly()
    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    State.FlyUp = false
    State.FlyDown = false
end

local function StartFly()
    StopFly()

    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return
    end

    FlyVelocity = Instance.new("BodyVelocity")
    FlyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    FlyVelocity.P = 25000
    FlyVelocity.Velocity = Vector3.zero
    FlyVelocity.Parent = root

    FlyGyro = Instance.new("BodyGyro")
    FlyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    FlyGyro.P = 25000
    FlyGyro.CFrame = root.CFrame
    FlyGyro.Parent = root
end

RunService.RenderStepped:Connect(function()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if humanoid then
        humanoid.WalkSpeed = State.SpeedEnabled and State.Speed or CONFIG.DefaultSpeed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = State.JumpEnabled and State.JumpPower or CONFIG.DefaultJump
    end

    if State.NoClipEnabled and character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = false
            end
        end
    end

    MobileFly.Visible = State.FlyEnabled and UserInputService.TouchEnabled

    if State.FlyEnabled and root then
        if not FlyVelocity or not FlyVelocity.Parent then
            StartFly()
        end

        if FlyVelocity then
            local camera = workspace.CurrentCamera
            local movement = Vector3.zero

            -- PC
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                movement += camera.CFrame.LookVector
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                movement -= camera.CFrame.LookVector
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                movement -= camera.CFrame.RightVector
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                movement += camera.CFrame.RightVector
            end

            -- PC vertical
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or State.FlyUp then
                movement += Vector3.yAxis
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or State.FlyDown then
                movement -= Vector3.yAxis
            end

            if movement.Magnitude > 0 then
                movement = movement.Unit
            end

            FlyVelocity.Velocity = movement * State.FlySpeed

            if FlyGyro then
                FlyGyro.CFrame = CFrame.lookAt(
                    root.Position,
                    root.Position + camera.CFrame.LookVector
                )
            end
        end
    else
        StopFly()
    end
end)

