local function CreateTab(name)
    local button = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = CONFIG.Button,
        Text = name,
        TextColor3 = CONFIG.SubText,
        TextSize = 13,
