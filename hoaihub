local function AddTab(tabName)
	local button = New("TextButton", {
		Name = tabName .. "Button",
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = CONFIG.Colors.Button,
		Text = tabName,
		TextColor3 = CONFIG.Colors.SubText,
		TextSize = 13,
		Font = Enum.Font.GothamSemibold,
		AutoButtonColor = false,
		ZIndex = 15,
	}, Sidebar)
	Corner(button, 8)

	local page = New("ScrollingFrame", {
		Name = tabName .. "Page",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = CONFIG.Colors.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		ZIndex = 12,
	}, PageHolder)

	New("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 12),
	}, page)

	New("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, page)

	Pages[tabName] = page
	TabButtons[tabName] = button

	button.MouseButton1Click:Connect(function()
		for name, tabPage in pairs(Pages) do
			local selected = name == tabName
			tabPage.Visible = selected
			local tabButton = TabButtons[name]
			if selected then
				Tween(tabButton, {
					BackgroundColor3 = CONFIG.Colors.Accent,
					TextColor3 = Color3.new(1, 1, 1),
				}, 0.12)
			else
				Tween(tabButton, {
					BackgroundColor3 = CONFIG.Colors.Button,
					TextColor3 = CONFIG.Colors.SubText,
				}, 0.12)
			end
		end
		State.CurrentTab = tabName
		PageTitle.Text = tabName:upper()
	end)

	return page
end

