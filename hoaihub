local FixLagButton = Create("TextButton", {
    Size = UDim2.new(1, 0, 0, 40),
    BackgroundColor3 = CONFIG.Colors.Button,
    Text = "Fix Lag / Low Effects",
    TextColor3 = CONFIG.Colors.Text,
    TextSize = 13,
    Font = Enum.Font.GothamSemibold,
    AutoButtonColor = false
}, SettingsPage)

AddCorner(FixLagButton, 8)

local function FixLag()
    local lighting = game:GetService("Lighting")

    lighting.GlobalShadows = false
    lighting.FogEnd = 100000

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("ParticleEmitter")
            or object:IsA("Trail")
            or object:IsA("Beam") then

            object.Enabled = false
        elseif object:IsA("PostEffect") then
            object.Enabled = false
        end
    end

    if workspace.CurrentCamera then
        workspace.CurrentCamera.FieldOfView =
            State.FOV
    end
end

FixLagButton.MouseButton1Click:Connect(FixLag)

