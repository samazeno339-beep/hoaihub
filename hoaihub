local FlyVelocity = nil
local FlyGyro = nil

local function StopFly()
    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    local humanoid = GetHumanoid()

    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function StartFly()
    local root = GetRoot()

    if not root then
        return
    end

    StopFly()

    FlyVelocity = Instance.new("BodyVelocity")

    FlyVelocity.Name = "HoaiFlyVelocity"

    FlyVelocity.MaxForce =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyVelocity.Velocity =
        Vector3.zero

    FlyVelocity.Parent = root

    FlyGyro = Instance.new("BodyGyro")

    FlyGyro.Name = "HoaiFlyGyro"

    FlyGyro.MaxTorque =
        Vector3.new(
            math.huge,
            math.huge,
            math.huge
        )

    FlyGyro.P =
        90000

    FlyGyro.D =
        1000

    FlyGyro.CFrame =
        workspace.CurrentCamera.CFrame

    FlyGyro.Parent = root

    local humanoid = GetHumanoid()

    if humanoid then
        humanoid.PlatformStand = true
    end
end

--========================================================--
-- MOVEMENT LOOP
--========================================================--

RunService.Heartbeat:Connect(function()
    local humanoid = GetHumanoid()
    local root = GetRoot()

    if not humanoid or not root then
        StopFly()
        return
    end

    -- SPEED
    if State.SpeedEnabled then
        humanoid.WalkSpeed =
            math.clamp(State.Speed, 16, 200)
    else
        humanoid.WalkSpeed =
            CONFIG.DefaultWalkSpeed
    end

    -- JUMP
    if State.JumpEnabled then
        humanoid.UseJumpPower = true
        humanoid.JumpPower =
            math.clamp(State.JumpPower, 50, 200)
    else
        humanoid.UseJumpPower = true
        humanoid.JumpPower =
            CONFIG.DefaultJumpPower
    end

    -- NOCLIP
    if State.NoClipEnabled then
        local character = GetCharacter()

        if character then
            for _, object in ipairs(
                character:GetDescendants()
            ) do

                if object:IsA("BasePart") then
                    object.CanCollide = false
                end
            end
        end
    end

    -- FLY
    if State.FlyEnabled then
        if not FlyVelocity
            or FlyVelocity.Parent ~= root then

            StartFly()
        end

        if FlyVelocity then
            local camera =
                workspace.CurrentCamera

            if camera then
                local direction =
                    Vector3.zero

                if keys.W then
                    direction +=
                        camera.CFrame.LookVector
                end

                if keys.S then
                    direction -=
                        camera.CFrame.LookVector
                end

                if keys.D then
                    direction +=
                        camera.CFrame.RightVector
                end

                if keys.A then
                    direction -=
                        camera.CFrame.RightVector
                end

                if flyUpHeld or keys.Space then
                    direction +=
                        Vector3.yAxis
                end

                if flyDownHeld
                    or keys.LeftControl then

                    direction -=
                        Vector3.yAxis
                end

                if direction.Magnitude > 0 then
                    direction =
                        direction.Unit
                        * State.FlySpeed
                end

                FlyVelocity.Velocity =
                    direction

                if FlyGyro then
                    FlyGyro.CFrame =
                        CFrame.lookAt(
                            root.Position,
                            root.Position +
                            camera.CFrame.LookVector
                        )
                end
            end
        end
    else
        StopFly()
    end

    UpdateFlyButtonVisibility()
end)

