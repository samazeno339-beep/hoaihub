local FlyController = {
	Attachment = nil,
	LinearVelocity = nil,
	AlignOrientation = nil,
	Connection = nil,
}

local function CleanupFly()
	if FlyController.Connection then
		FlyController.Connection:Disconnect()
		FlyController.Connection = nil
	end
	if FlyController.LinearVelocity then
		FlyController.LinearVelocity:Destroy()
		FlyController.LinearVelocity = nil
	end
	if FlyController.AlignOrientation then
		FlyController.AlignOrientation:Destroy()
		FlyController.AlignOrientation = nil
	end
	if FlyController.Attachment then
		FlyController.Attachment:Destroy()
		FlyController.Attachment = nil
	end
end

local function StopFly()
	CleanupFly()
	local char = GetCharacter()
	local hum = char and GetHumanoid(char)
	local root = char and GetRoot(char)
	if hum then
		hum.AutoRotate = true
	end
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
	State.FlyUp = false
	State.FlyDown = false
end

local function StartFly()
	StopFly()

	local char = GetCharacter()
	local hum = char and GetHumanoid(char)
	local root = char and GetRoot(char)
	if not char or not hum or not root then
		return
	end

	hum.AutoRotate = false

	local att = Instance.new("Attachment")
	att.Name = "HoaiFlyAttachment"
	att.Parent = root
	FlyController.Attachment = att

	local lv = Instance.new("LinearVelocity")
	lv.Name = "HoaiFlyLinearVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = math.huge
	lv.VectorVelocity = Vector3.zero
	lv.Parent = root
	FlyController.LinearVelocity = lv

	local ao = Instance.new("AlignOrientation")
	ao.Name = "HoaiFlyAlignOrientation"
	ao.Attachment0 = att
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.MaxTorque = math.huge
	ao.Responsiveness = 20
	ao.RigidityEnabled = false
	ao.Parent = root
	FlyController.AlignOrientation = ao

	FlyController.Connection = RunService.Heartbeat:Connect(function(dt)
		if not State.FlyEnabled then
			StopFly()
			return
		end

		local char2 = GetCharacter()
		local hum2 = char2 and GetHumanoid(char2)
		local root2 = char2 and GetRoot(char2)
		local camera = GetCamera()

		if not char2 or not hum2 or not root2 or not camera then
			return
		end

		local look = camera.CFrame.LookVector
		local right = camera.CFrame.RightVector

		local forward = Vector3.new(look.X, 0, look.Z)
		local strafe = Vector3.new(right.X, 0, right.Z)

		if forward.Magnitude > 0 then
			forward = forward.Unit
		end
		if strafe.Magnitude > 0 then
			strafe = strafe.Unit
		end

		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += forward end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= forward end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= strafe end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += strafe end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or State.FlyUp then move += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or State.FlyDown then move -= Vector3.yAxis end

		if move.Magnitude > 0 then
			move = move.Unit
		end

		local targetVelocity = move * Clamp(State.FlySpeed, 1, 1000)
		lv.VectorVelocity = lv.VectorVelocity:Lerp(targetVelocity, Clamp(dt * 12, 0, 1))

		local face = Vector3.new(look.X, 0, look.Z)
		if face.Magnitude > 0 then
			ao.CFrame = CFrame.lookAt(Vector3.zero, face.Unit)
		end
	end)
end

local function SetFly(enabled)
	State.FlyEnabled = enabled and true or false
	if State.FlyEnabled then
		StartFly()
	else
		StopFly()
	end
end

