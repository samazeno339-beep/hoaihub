local function Clamp(n, a, b)
	return math.max(a, math.min(b, n))
end

local function New(className, props, parent)
	local obj = Instance.new(className)
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function Corner(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = obj
	return c
end

local function Stroke(obj, color, transparency, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or CONFIG.Colors.Accent
	s.Transparency = transparency or 0.55
	s.Thickness = thickness or 1
	s.Parent = obj
	return s
end

local function Tween(obj, props, t)
	if not obj or not obj.Parent then
		return
	end
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function FormatTime(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	return string.format("%02d:%02d:%02d", h, m, s)
end

local function GetCharacter(plr)
	plr = plr or LocalPlayer
	return plr.Character
end

local function GetHumanoid(model)
	if not model then return nil end
	return model:FindFirstChildOfClass("Humanoid")
end

local function GetRoot(model)
	if not model then return nil end
	return model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChild("UpperTorso")
		or model:FindFirstChild("Torso")
		or model:FindFirstChild("Head")
		or model.PrimaryPart
end

local function IsAlive(model)
	local hum = GetHumanoid(model)
	return hum and hum.Health > 0
end

local function GetCamera()
	return Workspace.CurrentCamera
end

local function GetPingText()
	local ok, result = pcall(function()
		local network = Stats:FindFirstChild("Network")
		local serverStats = network and network:FindFirstChild("ServerStatsItem")
		local pingItem = serverStats and serverStats:FindFirstChild("Data Ping")
		if pingItem and pingItem.GetValueString then
			return pingItem:GetValueString()
		end
		return "N/A"
	end)
	return ok and result or "N/A"
end

local function GetServerStartUnix()
	local attr = Workspace:GetAttribute("ServerStartUnix")
	if typeof(attr) == "number" then
		return attr
	end
	return nil
end

local function GetLevelText(model, player)
	if not model then return nil end

	local attr = model:GetAttribute("Level")
	if typeof(attr) == "number" then
		return tostring(attr)
	end

	local levelObj = model:FindFirstChild("Level", true)
	if levelObj and levelObj:IsA("ValueBase") then
		return tostring(levelObj.Value)
	end

	if player then
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			local lv = leaderstats:FindFirstChild("Level")
			if lv and lv:IsA("ValueBase") then
				return tostring(lv.Value)
			end
		end
	end

	return nil
end

local function GetAimPart(model)
	if not model then return nil end

	if State.AimTargetPart == "UpperTorso" then
		return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
	elseif State.AimTargetPart == "HumanoidRootPart" then
		return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("Head") or model.PrimaryPart
	else
		return model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("UpperTorso") or model.PrimaryPart
	end
end

local function IsEnemyPlayer(plr)
	if not plr or plr == LocalPlayer then
		return false
	end
	if not State.AimTeamCheck then
		return true
	end
	if not LocalPlayer.Team or not plr.Team then
		return true
	end
	return LocalPlayer.Team ~= plr.Team
end

local function HasLineOfSight(targetModel, targetPart)
	if not State.AimWallCheck then
		return true
	end
	local camera = GetCamera()
	if not camera or not targetPart then
		return false
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.IgnoreWater = true

	local ignore = {}
	if LocalPlayer.Character then
		table.insert(ignore, LocalPlayer.Character)
	end
	params.FilterDescendantsInstances = ignore

	local origin = camera.CFrame.Position
	local direction = targetPart.Position - origin
	local result = Workspace:Raycast(origin, direction, params)

	if not result then
		return true
	end

	return result.Instance and result.Instance:IsDescendantOf(targetModel)
end

local function GetDistanceText(model)
	local myChar = GetCharacter()
	local myRoot = myChar and GetRoot(myChar)
	local targetRoot = model and GetRoot(model)
	if myRoot and targetRoot then
		local d = (myRoot.Position - targetRoot.Position).Magnitude
		return string.format("%dm", math.floor(d))
	end
	return nil
end

local function GetAllNPCModels()
	local out = {}
	local seen = {}

	for _, tagged in ipairs(CollectionService:GetTagged("HoaiTarget")) do
		if tagged:IsA("Model") and not seen[tagged] then
			local hum = GetHumanoid(tagged)
			local root = GetRoot(tagged)
			if hum and root and hum.Health > 0 then
				seen[tagged] = true
				table.insert(out, tagged)
			end
		end
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and not seen[obj] and not Players:GetPlayerFromCharacter(obj) then
			local hum = GetHumanoid(obj)
			local root = GetRoot(obj)
			if hum and root and hum.Health > 0 then
				seen[obj] = true
				table.insert(out, obj)
			end
		end
	end

	return out
end

local function GetTargetCandidates()
	local candidates = {}

	if State.AimTargetPlayers then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local char = plr.Character
				if char and IsAlive(char) and IsEnemyPlayer(plr) then
					table.insert(candidates, char)
				end
			end
		end
	end

	if State.AimTargetNPC then
		for _, npc in ipairs(GetAllNPCModels()) do
			if npc and npc.Parent and IsAlive(npc) and not Players:GetPlayerFromCharacter(npc) then
				table.insert(candidates, npc)
			end
		end
	end

	return candidates
end

local function SelectBestTarget()
	local camera = GetCamera()
	if not camera then
		return nil, nil
	end

	local center = camera.ViewportSize / 2
	local bestModel = nil
	local bestPart = nil
	local bestDist = math.huge

	for _, model in ipairs(GetTargetCandidates()) do
		local part = GetAimPart(model)
		if part then
			local screenPos, visible = camera:WorldToViewportPoint(part.Position)
			if visible and screenPos.Z > 0 then
				local d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude

				if d <= State.AimFOV / 2 and d < bestDist and HasLineOfSight(model, part) then
					local myChar = GetCharacter()
					local myRoot = myChar and GetRoot(myChar)
					local targetRoot = GetRoot(model)
					local distText = nil
					if myRoot and targetRoot then
						local dist = (myRoot.Position - targetRoot.Position).Magnitude
						if dist <= State.AimMaxDistance then
							bestDist = d
							bestModel = model
							bestPart = part
						end
					else
						bestDist = d
						bestModel = model
						bestPart = part
					end
				end
			end
		end
	end

	return bestModel, bestPart
end

local function UpdateUniversalTarget()
	local model, part = SelectBestTarget()
	State.CurrentTarget = model
	return model, part
end

local function UpdateESPText(model, player)
	local hum = GetHumanoid(model)
	local lines = {}

	if State.ShowName then
		table.insert(lines, player and player.Name or model.Name)
	end

	if State.ShowDistance then
		local d = GetDistanceText(model)
		if d then
			table.insert(lines, d)
		end
	end

	if State.ShowHealth and hum then
		table.insert(lines, string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth)))
	end

	if State.ShowLevel then
		local level = GetLevelText(model, player)
		if level then
			table.insert(lines, "Level: " .. level)
		end
	end

	return table.concat(lines, "\n")
end

local function GetServerAgeText()
	local startUnix = GetServerStartUnix()
	if typeof(startUnix) == "number" then
		return FormatTime(os.time() - startUnix)
	end
	return FormatTime(math.floor(os.clock()))
end

