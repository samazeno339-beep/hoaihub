local function AddToggle(parent, label, key)
    local button = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = CONFIG.Button,
        Text = label .. " : OFF",
        TextColor3 = CONFIG.Text,
        TextSize = 13,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = false,
    }, parent)

    Corner(button, 8)

    button.MouseButton1Click:Connect(function()
        State[key] = not State[key]

        button.Text = label .. " : " .. (State[key] and "ON" or "OFF")

        SafeTween(button, {
            BackgroundColor3 = State[key] and CONFIG.Accent or CONFIG.Button,
        })
    end)

    return button
end

local function AddNumberBox(parent, placeholder, key, minimum, maximum)
    local box = New("TextBox", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = CONFIG.Button,
        Text = tostring(State[key]),
        PlaceholderText = placeholder,
        TextColor3 = CONFIG.Text,
        TextSize = 13,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false,
    }, parent)

    Corner(box, 8)

    box.FocusLost:Connect(function()
        local number = tonumber(box.Text)

        if not number then
            box.Text = tostring(State[key])
            return
        end

        State[key] = math.clamp(number, minimum, maximum)
        box.Text = tostring(math.floor(State[key]))
    end)

    return box
end

