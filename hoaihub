MakeLabel(AimPage, "ESP")

local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "HoaiHubESP"
ESPFolder.Parent = ScreenGui

local ESPObjects = {}

local function RemoveESP(instance)
    local object = ESPObjects[instance]

    if object then
        if object.Highlight then
            object.Highlight:Destroy()
        end

        if object.Billboard then
            object.Billboard:Destroy()
        end

        ESPObjects[instance] = nil
    end
end

local function CreateESP(instance, labelText)
    if ESPObjects[instance] then
        return
    end

    if not instance:IsA("Model") then
        return
    end

    local humanoid = instance:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    local root =
        instance:FindFirstChild("HumanoidRootPart")
        or instance:FindFirstChild("Head")

    if not root or not root:IsA("BasePart") then
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "HoaiHighlight"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.75
    highlight.OutlineTransparency = 0
    highlight.FillColor = CONFIG.Colors.Accent
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.Adornee = instance
    highlight.Parent = ESPFolder

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "HoaiName"
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(150, 32)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ESPFolder

    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.Text = labelText
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0
    text.TextSize = 12
    text.Font = Enum.Font.GothamBold
    text.Parent = billboard

    ESPObjects[instance] = {
        Highlight = highlight,
        Billboard = billboard
    }
end

local function ClearAllESP()
    for instance in pairs(ESPObjects) do
        RemoveESP(instance)
    end
end

local function UpdatePlayerESP()
    if not State.ESPPlayer then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer
            and player.Character
            and IsAlive(player) then

            CreateESP(
                player.Character,
                player.DisplayName
            )
        end
    end
end

local function UpdateNPCESP()
    if not State.ESPNPC then
        return
    end

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Model")
            and not Players:GetPlayerFromCharacter(object)
            and object:FindFirstChildOfClass("Humanoid") then

            CreateESP(
                object,
                object.Name
            )
        end
    end
end

MakeToggle(
    AimPage,
    "Player ESP",
    function(enabled)
        State.ESPPlayer = enabled

        if not enabled and not State.ESPNPC then
            ClearAllESP()
        end
    end
)

MakeToggle(
    AimPage,
    "NPC ESP",
    function(enabled)
        State.ESPNPC = enabled

        if not enabled and not State.ESPPlayer then
            ClearAllESP()
        end
    end
)

--========================================================--
-- AIM LOOP
--========================================================--

RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    if State.AimEnabled then
        local target = State.AimTarget

        if not target or not IsAlive(target) then
            target = FindBestTarget()
            State.AimTarget = target
        end

        if target then
            local root = GetCharacterRoot(target)

            if root then
                local desired =
                    CFrame.lookAt(
                        Camera.CFrame.Position,
                        root.Position
                    )

                Camera.CFrame =
                    Camera.CFrame:Lerp(
                        desired,
                        State.AimSmoothness
                    )
            end
        end
    end

    if State.ESPPlayer or State.ESPNPC then
        UpdatePlayerESP()
        UpdateNPCESP()
    end
end)

