local TravelController = {
	Attachment = nil,
	LinearVelocity = nil,
	AlignOrientation = nil,
	Connection = nil,
}

local function CleanupTravel()
	if TravelController.Connection then
		TravelController.Connection:Disconnect()
		TravelController.Connection = nil
	end
	if TravelController.LinearVelocity then
		TravelController.LinearVelocity:Destroy()
		TravelController.LinearVelocity = nil
	end
	if TravelController.AlignOrientation then
		TravelController.AlignOrientation:Destroy()
		TravelController.AlignOrientation = nil
	end
	if TravelController.Attachment then
		TravelController.Attachment:Destroy()
		TravelController.Attachment = nil
	end
	State.Traveling = false
end

local function StopTravel()
	CleanupTravel()
	local char = GetCharacter()
	local hum = char and GetHumanoid(char)
	local root = char and GetRoot(char)
	if hum then
		hum.AutoRotate = true
	end
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

local function StartTravel(targetPlayer)
	StopTravel()

	if not targetPlayer or not targetPlayer.Character then
		return
	end

	local char = GetCharacter()
	local hum = char and GetHumanoid(char)
	local root = char and GetRoot(char)
	if not char or not hum or not root then
		return
	end

	local targetRoot = GetRoot(targetPlayer.Character)
	if not targetRoot then
		return
	end

	State.Traveling = true
	hum.AutoRotate = false

	local att = Instance.new("Attachment")
	att.Name = "HoaiTravelAttachment"
	att.Parent = root
	TravelController.Attachment = att

	local lv = Instance.new("LinearVelocity")
	lv.Name = "HoaiTravelVelocity"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.MaxForce = math.huge
	lv.VectorVelocity = Vector3.zero
	lv.Parent = root
	TravelController.LinearVelocity = lv

	local ao = Instance.new("AlignOrientation")
	ao.Name = "HoaiTravelAlignOrientation"
	ao.Attachment0 = att
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.MaxTorque = math.huge
	ao.Responsiveness = 18
	ao.RigidityEnabled = false
	ao.Parent = root
	TravelController.AlignOrientation = ao

	TravelController.Connection = RunService.Heartbeat:Connect(function(dt)
		if not State.Traveling then
			StopTravel()
			return
		end

		local char2 = GetCharacter()
		local hum2 = char2 and GetHumanoid(char2)
		local root2 = char2 and GetRoot(char2)

		local tChar = targetPlayer.Character
		local tRoot = tChar and GetRoot(tChar)

		if not char2 or not hum2 or not root2 or not tRoot then
			return
		end

		local delta = tRoot.Position - root2.Position
		local distance = delta.Magnitude

		if distance <= 3 then
			StopTravel()
			return
		end

		local direction = delta.Unit
		local targetVel = direction * Clamp(State.TPSpeed, 1, 1000)
		lv.VectorVelocity = lv.VectorVelocity:Lerp(targetVel, Clamp(dt * 10, 0, 1))
		ao.CFrame = CFrame.lookAt(Vector3.zero, direction)
	end)
end

