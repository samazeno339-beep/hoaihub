local function CreateToggle(parent, title, defaultValue, callback)
    local row = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 42),

        BackgroundColor3 = CONFIG.Colors.Button,

        BorderSizePixel = 0,

        ZIndex = 14
    }, parent)

    AddCorner(row, 8)

    Create("TextLabel", {
        Position = UDim2.fromOffset(10, 0),

        Size = UDim2.new(1, -70, 1, 0),

        BackgroundTransparency = 1,

        Text = title,

        TextColor3 = CONFIG.Colors.Text,
        TextSize = 13,

        Font = Enum.Font.GothamSemibold,

        TextXAlignment = Enum.TextXAlignment.Left,

        ZIndex = 15
    }, row)

    local button = Create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),

        Position = UDim2.new(1, -8, 0.5, 0),

        Size = UDim2.fromOffset(42, 24),

        BackgroundColor3 = CONFIG.Colors.Background,

        Text = "",

        AutoButtonColor = false,

        ZIndex = 16
    }, row)

    AddCorner(button, 12)

    local dot = Create("Frame", {
        Position = UDim2.fromOffset(3, 3),

        Size = UDim2.fromOffset(18, 18),

        BackgroundColor3 = CONFIG.Colors.SubText,

        BorderSizePixel = 0,

        ZIndex = 17
    }, button)

    AddCorner(dot, 10)

    local enabled = defaultValue == true

    local function Update()
        if enabled then
            button.BackgroundColor3 = CONFIG.Colors.Accent
            dot.BackgroundColor3 = Color3.new(1, 1, 1)
            dot.Position = UDim2.new(1, -21, 0, 3)
        else
            button.BackgroundColor3 = CONFIG.Colors.Background
            dot.BackgroundColor3 = CONFIG.Colors.SubText
            dot.Position = UDim2.fromOffset(3, 3)
        end
    end

    Update()

    button.MouseButton1Click:Connect(function()
        enabled = not enabled

        Update()

        if callback then
            callback(enabled)
        end
    end)

    return {
        Set = function(value)
            enabled = value == true
            Update()

            if callback then
                callback(enabled)
            end
        end,

        Get = function()
            return enabled
        end
    }
end

