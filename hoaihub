local scaleDragging = false

local function SetScaleFromX(x)
	local width = ScaleBar.AbsoluteSize.X
	if width <= 0 then return end

	local alpha = Clamp(
		(x - ScaleBar.AbsolutePosition.X) / width,
		0,
		1
	)

	ApplyUIScale(50 + alpha * 100)
end

