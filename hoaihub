local function MakeToggle(parent, label, defaultValue, callback)
	local enabled = defaultValue == true

	local button = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = enabled and CONFIG.Colors.Accent or CONFIG.Colors.Button,
		Text = label .. " : " .. (enabled and "ON" or "OFF"),
		TextColor3 = CONFIG.Colors.Text,
		TextSize = 13,
		Font = Enum.Font.GothamSemibold,
		AutoButtonColor = false,
	}, parent)
	Corner(button, 8)

	local function Set(value, fireCallback)
		enabled = value == true
		button.Text = label .. " : " .. (enabled and "ON" or "OFF")
		Tween(button, {
			BackgroundColor3 = enabled and CONFIG.Colors.Accent or CONFIG.Colors.Button
		}, 0.12)
		if fireCallback and callback then callback(enabled) end
	end

	button.MouseButton1Click:Connect(function()
		Set(not enabled, true)
	end)

	if callback then callback(enabled) end
	return button, Set
end

local function MakeNumberBox(parent, placeholder, defaultValue, minValue, maxValue, callback)
	local box = New("TextBox", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = CONFIG.Colors.Button,
		Text = tostring(defaultValue),
		PlaceholderText = placeholder,
		TextColor3 = CONFIG.Colors.Text,
		TextSize = 13,
		Font = Enum.Font.Gotham,
		ClearTextOnFocus = false,
	}, parent)
	Corner(box, 8)

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if not n then
			box.Text = tostring(defaultValue)
			return
		end
		n = Clamp(n, minValue, maxValue)
		box.Text = tostring(math.floor(n))
		if callback then callback(n) end
	end)

	return box
end

local function MakeSlider(parent, title, defaultValue, minValue, maxValue, callback)
	local container = New("Frame", {
		Size = UDim2.new(1, 0, 0, 66),
		BackgroundColor3 = CONFIG.Colors.Button,
		BorderSizePixel = 0,
	}, parent)
	Corner(container, 8)

	New("TextLabel", {
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -95, 0, 18),
		BackgroundTransparency = 1,
		Text = title,
		TextColor3 = CONFIG.Colors.Text,
		TextSize = 13,
		Font = Enum.Font.GothamSemibold,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, container)

	local valueLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Size = UDim2.fromOffset(70, 18),
		BackgroundTransparency = 1,
		TextColor3 = CONFIG.Colors.Text,
		TextSize = 12,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, container)

	local bar = New("Frame", {
		Position = UDim2.fromOffset(12, 42),
		Size = UDim2.new(1, -24, 0, 10),
		BackgroundColor3 = CONFIG.Colors.Background,
		BorderSizePixel = 0,
	}, container)
	Corner(bar, 999)

	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = CONFIG.Colors.Accent,
		BorderSizePixel = 0,
	}, bar)
	Corner(fill, 999)

	local current = Clamp(defaultValue, minValue, maxValue)
	local draggingSlider = false

	local function SetValue(v)
		current = Clamp(v, minValue, maxValue)
		local alpha = (current - minValue) / (maxValue - minValue)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		valueLabel.Text = tostring(math.floor(current))
		if callback then callback(current) end
	end

	local function SetFromX(x)
		if bar.AbsoluteSize.X <= 0 then return end
		local alpha = Clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		SetValue(minValue + (maxValue - minValue) * alpha)
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)

	SetValue(current)
	return {Set = SetValue, Get = function() return current end}
end

local function MakeCycle(parent, label, values, defaultValue, callback)
	local index = table.find(values, defaultValue) or 1

	local button = New("TextButton", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = CONFIG.Colors.Button,
		Text = label .. " : " .. tostring(values[index]),
		TextColor3 = CONFIG.Colors.Text,
		TextSize = 13,
		Font = Enum.Font.GothamSemibold,
		AutoButtonColor = false,
	}, parent)
	Corner(button, 8)

	button.MouseButton1Click:Connect(function()
		index = index % #values + 1
		button.Text = label .. " : " .. tostring(values[index])
		if callback then callback(values[index]) end
	end)

	if callback then callback(values[index]) end
	return button
end

