local function RefreshESP()
	-- players
	if State.PlayerESP then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character and IsEnemyPlayer(plr) then
				CreateESP(plr.Character, plr, false)
			end
		end
	end

	-- npc
	if State.NPCESP then
		for _, npc in ipairs(NPCCache) do
			if npc and npc.Parent and IsAlive(npc) and not Players:GetPlayerFromCharacter(npc) then
				CreateESP(npc, nil, true)
			end
		end
	end

	-- cleanup
	for model, data in pairs(ESPByModel) do
		if not model or not model.Parent then
			if data.Billboard then data.Billboard:Destroy() end
			if data.Highlight then data.Highlight:Destroy() end
			ESPByModel[model] = nil
		end
	end

	-- update text
	for model, data in pairs(ESPByModel) do
		if model and model.Parent and data.Text then
			data.Text.Text = UpdateESPText(model, data.Player)
			if data.Highlight then
				data.Highlight.Enabled = State.ShowHighlight
			end
		end
	end
end

local function RefreshNPCCache()
	local list = {}
	for _, npc in ipairs(GetAllNPCModels()) do
		table.insert(list, npc)
	end
	NPCCache = list
end

