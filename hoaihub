local MoveConfig = {

	Speed = 16,
	Jump = 50,
	FlySpeed = 50,

	SpeedEnabled = false,
	JumpEnabled = false,
	FlyEnabled = false,
	NoClipEnabled = false,
	ShiftLockEnabled = false

