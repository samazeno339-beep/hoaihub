local upCorner = Instance.new("UICorner")
upCorner.CornerRadius = UDim.new(1, 0)
upCorner.Parent = flyUp

local flyDown = Instance.new("TextButton")
flyDown.Name = "FlyDown"
flyDown.Size = UDim2.fromOffset(42, 38)
flyDown.Position = UDim2.new(1, -50, 1, -110)
flyDown.BackgroundColor3 = Color3.fromRGB(92, 45, 150)
flyDown.Text = "▼"
flyDown.TextColor3 = Color3.new(1, 1, 1)
flyDown.Font = Enum.Font.GothamBold
flyDown.TextSize = 17
flyDown.Visible = false
flyDown.Parent = H.GUI

local downCorner = Instance.new("UICorner")
downCorner.CornerRadius = UDim.new(1, 0)
downCorner.Parent = flyDown

local flyUpHeld = false
local flyDownHeld = false

flyUp.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		flyUpHeld = true
	end
end)

flyUp.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		flyUpHeld = false
	end
end)

flyDown.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		flyDownHeld = true
	end
end)

flyDown.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		flyDownHeld = false
	end
end)

--==================================================
-- FLY OBJECTS
--==================================================

local function removeFlyObjects(root)
	if not root then
		return
	end

	local velocity = root:FindFirstChild("HoaiFlyVelocity")
	if velocity then
		velocity:Destroy()
	end

	local gyro = root:FindFirstChild("HoaiFlyGyro")
	if gyro then
		gyro:Destroy()
	end
end

local function createFlyObjects(root)
	local velocity = root:FindFirstChild("HoaiFlyVelocity")

	if not velocity then
		velocity = Instance.new("BodyVelocity")
		velocity.Name = "HoaiFlyVelocity"
		velocity.MaxForce = Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)
		velocity.P = 15000
		velocity.Velocity = Vector3.zero
		velocity.Parent = root
	end

	local gyro = root:FindFirstChild("HoaiFlyGyro")

	if not gyro then
		gyro = Instance.new("BodyGyro")
		gyro.Name = "HoaiFlyGyro"
		gyro.MaxTorque = Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)
		gyro.P = 20000
		gyro.D = 800
		gyro.Parent = root
	end

	return velocity, gyro
end

--==================================================
-- NOCLIP
--==================================================

local function setNoClip(character, enabled)
	if not character then
		return
	end

	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = not enabled
		end
	end
end

--==================================================
-- SHIFTLOCK
--==================================================

local function updateShiftLock()
	local humanoid = H.GetHumanoid()

	if not humanoid then
		return
	end

	if H.Settings.ShiftLock then
		humanoid.AutoRotate = false
		humanoid.CameraOffset = Vector3.new(1.65, 0, 0)
	else
		humanoid.AutoRotate = true
		humanoid.CameraOffset = Vector3.zero
	end
end

--==================================================
-- FIX LAG / REMOVE EFFECTS
--==================================================

local savedEffects = {}
local savedPostEffects = {}

local effectsEnabled = false

local function disableEffect(obj)
	if not obj then
		return
	end

	if obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("Smoke")
		or obj:IsA("Fire")
		or obj:IsA("Sparkles") then

		if savedEffects[obj] == nil then
			savedEffects[obj] = obj.Enabled
		end

		obj.Enabled = false
	end
end

local function disablePostEffect(obj)
	if not obj then
		return
	end

	if obj:IsA("PostEffect") then
		if savedPostEffects[obj] == nil then
			savedPostEffects[obj] = obj.Enabled
		end

		obj.Enabled = false
	end
end

local function disableAllEffects()
	for _, obj in ipairs(workspace:GetDescendants()) do
		disableEffect(obj)
	end

	for _, obj in ipairs(Lighting:GetDescendants()) do
		disableEffect(obj)
		disablePostEffect(obj)
	end

	effectsEnabled = true
end

local function restoreAllEffects()
	for obj, oldState in pairs(savedEffects) do
		if obj and obj.Parent then
			obj.Enabled = oldState
		end
	end

	for obj, oldState in pairs(savedPostEffects) do
		if obj and obj.Parent then
			obj.Enabled = oldState
		end
	end

	table.clear(savedEffects)
	table.clear(savedPostEffects)

	effectsEnabled = false
end

local function updateEffects()
	local shouldDisable =
		H.Settings.FixLag
		or H.Settings.RemoveEffects

	if shouldDisable and not effectsEnabled then
		disableAllEffects()
	elseif not shouldDisable and effectsEnabled then
		restoreAllEffects()
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if H.Settings.FixLag or H.Settings.RemoveEffects then
		disableEffect(obj)
	end
end)

Lighting.DescendantAdded:Connect(function(obj)
	if H.Settings.FixLag or H.Settings.RemoveEffects then
		disableEffect(obj)
		disablePostEffect(obj)
	end
end)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(function(character)
	task.wait(0.5)

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		if H.Settings.Speed then
			humanoid.WalkSpeed = H.Settings.WalkSpeed
		else
			humanoid.WalkSpeed = 16
		end

		if H.Settings.Jump then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = H.Settings.JumpPower
		end
	end

	updateShiftLock()
end)

--==================================================
-- SHIFTLOCK HOTKEY
--==================================================

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.LeftShift
		or input.KeyCode == Enum.KeyCode.RightShift then

		H.Settings.ShiftLock = not H.Settings.ShiftLock
		updateShiftLock()
	end
end)

--==================================================
-- MAIN LOOP
--==================================================

local lastFPSUpdate = os.clock()
local frameCount = 0

RunService.RenderStepped:Connect(function(deltaTime)

	local character = H.GetCharacter()
	local humanoid = H.GetHumanoid()
	local root = H.GetRoot()
	local camera = workspace.CurrentCamera

	--==============================================
	-- FPS
	--==============================================

	frameCount += 1

	local currentTime = os.clock()

	if currentTime - lastFPSUpdate >= 1 then

		local fps = frameCount / (currentTime - lastFPSUpdate)

		frameCount = 0
		lastFPSUpdate = currentTime

		local pingText = "--"

		local success, ping = pcall(function()
			return player:GetNetworkPing() * 1000
		end)

		if success and typeof(ping) == "number" then
			pingText = string.format("%.0f", ping)
		end

		if H.FPSLabel then
			H.FPSLabel.Text = string.format(
				"FPS: %.0f | Ping: %s ms",
				fps,
				pingText
			)
		end
	end

	--==============================================
	-- CHARACTER CHECK
	--==============================================

	if not character or not humanoid or not root then
		return
	end

	--==============================================
	-- SPEED
	--==============================================

	if H.Settings.Speed then
		humanoid.WalkSpeed = H.Settings.WalkSpeed
	else
		humanoid.WalkSpeed = 16
	end

	--==============================================
	-- JUMP
	--==============================================

	humanoid.UseJumpPower = true

	if H.Settings.Jump then
		humanoid.JumpPower = H.Settings.JumpPower
	else
		humanoid.JumpPower = 50
	end

	--==============================================
	-- NOCLIP
	--==============================================

	if H.Settings.NoClip then
		setNoClip(character, true)
	end

	--==============================================
	-- SHIFTLOCK
	--==============================================

	if H.Settings.ShiftLock then

		humanoid.AutoRotate = false
		humanoid.CameraOffset = Vector3.new(1.65, 0, 0)

		if camera then

			local lookVector = camera.CFrame.LookVector

			local flatDirection = Vector3.new(
				lookVector.X,
				0,
				lookVector.Z
			)

			if flatDirection.Magnitude > 0.01 then

				flatDirection = flatDirection.Unit

				local targetCFrame = CFrame.lookAt(
					root.Position,
					root.Position + flatDirection
				)

				root.CFrame = root.CFrame:Lerp(
					targetCFrame,
					math.clamp(deltaTime * 12, 0, 1)
				)

			end
		end

	else

		humanoid.AutoRotate = true
		humanoid.CameraOffset = Vector3.zero

	end

	--==============================================
	-- FLY
	--==============================================

	if H.Settings.Fly then

		flyUp.Visible = true
		flyDown.Visible = true

		humanoid.PlatformStand = true

		local velocity, gyro =
			createFlyObjects(root)

		local moveDirection =
			humanoid.MoveDirection

		local horizontalVelocity =
			moveDirection * H.Settings.FlySpeed

		local verticalVelocity = 0

		if flyUpHeld
			or UserInputService:IsKeyDown(Enum.KeyCode.Space) then

			verticalVelocity =
				H.Settings.FlySpeed
		end

		if flyDownHeld
			or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then

			verticalVelocity =
				-H.Settings.FlySpeed
		end

		local targetVelocity = Vector3.new(
			horizontalVelocity.X,
			verticalVelocity,
			horizontalVelocity.Z
		)

		-- Smooth fly để tránh giật
		velocity.Velocity =
			velocity.Velocity:Lerp(
				targetVelocity,
				math.clamp(deltaTime * 10, 0, 1)
			)

		if camera then

			gyro.CFrame =
				CFrame.lookAt(
					root.Position,
					root.Position + camera.CFrame.LookVector
				)

		end

	else

		flyUp.Visible = false
		flyDown.Visible = false

		humanoid.PlatformStand = false

		removeFlyObjects(root)

	end

	--==============================================
	-- EFFECTS
	--==============================================

	updateEffects()

	--==============================================
	-- STATUS
	--==============================================

	if H.StatusLabel then

		H.StatusLabel.Text = string.format(
			"ShiftLock: %s | Aim: %s",
			H.Settings.ShiftLock and "ON" or "OFF",
			H.Settings.Aim and "ON" or "OFF"
		)

	end

end)

--==================================================
-- KEYBOARD MENU
-- RightControl mở / đóng menu
--==================================================

UserInputService.InputBegan:Connect(function(input, processed)

	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.RightControl then

		H.Main.Visible =
			not H.Main.Visible

	end

end)

--==================================================
-- CLEANUP KHI SCRIPT CHẠY LẠI
--==================================================

game:BindToClose(function()

	if effectsEnabled then
		restoreAllEffects()
	end

	local character = H.GetCharacter()

	if character then
		local humanoid =
			character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
			humanoid.AutoRotate = true
			humanoid.CameraOffset = Vector3.zero
			humanoid.PlatformStand = false
		end

		setNoClip(character, false)

		local root =
			character:FindFirstChild("HumanoidRootPart")

		if root then
			removeFlyObjects(root)
		end
	end

end)

