local function makePage(name)
	local page = Instance.new("ScrollingFrame")
	page.Name = name
	page.Size = UDim2.fromScale(1, 1)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 2
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.CanvasSize = UDim2.new()
	page.Visible = false
	page.Parent = content

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 5)
	layout.Parent = page

	H.Pages[name] = page
	return page
end

local function setActivePage(pageName)
	for name, page in pairs(H.Pages) do
		page.Visible = (name == pageName)
	end
	for name, btn in pairs(H.Tabs) do
		btn.BackgroundColor3 = (name == pageName) and Color3.fromRGB(92, 45, 150) or Color3.fromRGB(30, 27, 39)
	end
end

local function makeTab(text, pageName, order)
	local b = Instance.new("TextButton")
	b.Size = UDim2.fromOffset(70, 27)
	b.BackgroundColor3 = Color3.fromRGB(30, 27, 39)
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 8
	b.LayoutOrder = order
	b.Parent = sidebar
	corner(b, 7)

	H.Tabs[pageName] = b

	b.Activated:Connect(function()
		setActivePage(pageName)
	end)
end

