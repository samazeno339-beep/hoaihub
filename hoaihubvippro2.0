local PlayerGui = player:WaitForChild("PlayerGui")

local AVATAR_IMAGE = "rbxassetid://96252137987835"

_G.HoaiHub = _G.HoaiHub or {}
local H = _G.HoaiHub

H.Settings = {
	Fly = false,
	Speed = false,
	Jump = false,
	NoClip = false,

	ShiftLock = false,
	Aim = false,
	ESP = false,

	FixLag = false,
	RemoveEffects = false,

	WalkSpeed = 32,
	JumpPower = 70,
	FlySpeed = 60,

	AimRange = 250,
	AimSmooth = 0.18,

	MenuSize = 10,
}

local function getCharacter()
	return player.Character
end

local function getRoot()
	local c = getCharacter()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local c = getCharacter()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function setCharacterCollision(state)
	local c = getCharacter()
	if not c then return end
	for _, obj in ipairs(c:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = state
		end
	end
end

local function corner(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = obj
	return c
end

local function stroke(obj, thickness)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(155, 75, 255)
	s.Thickness = thickness
	s.Transparency = 0.15
	s.Parent = obj
	return s
end

local function makeLabel(parent, text, height)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -8, 0, height or 32)
	l.BackgroundColor3 = Color3.fromRGB(25, 23, 33)
	l.Text = text
	l.TextColor3 = Color3.fromRGB(240, 240, 245)
	l.Font = Enum.Font.Gotham
	l.TextSize = 10
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Parent = parent
	corner(l, 8)
	return l
end

local function makeToggle(parent, text, initial, callback)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -8, 0, 34)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 10
	b.Parent = parent
	corner(b, 8)

	local state = initial == true

	local function render()
		b.Text = text .. (state and "  [ON]" or "  [OFF]")
		b.BackgroundColor3 = state and Color3.fromRGB(90, 44, 148) or Color3.fromRGB(31, 28, 40)
	end

	render()

	b.Activated:Connect(function()
		state = not state
		render()
		callback(state)
	end)

	return b
end

local function makeNumberBox(parent, labelText, value, minValue, maxValue, callback)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -8, 0, 34)
	box.BackgroundColor3 = Color3.fromRGB(31, 28, 40)
	box.Text = tostring(value)
	box.PlaceholderText = labelText
	box.TextColor3 = Color3.new(1, 1, 1)
	box.Font = Enum.Font.Gotham
	box.TextSize = 10
	box.ClearTextOnFocus = false
	box.Parent = parent
	corner(box, 8)

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			n = math.clamp(n, minValue, maxValue)
			box.Text = tostring(n)
			callback(n)
		else
			box.Text = tostring(value)
		end
	end)

	return box
end

local function makeButton(parent, text, callback, height)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -8, 0, height or 34)
	b.BackgroundColor3 = Color3.fromRGB(31, 28, 40)
	b.Text = text
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 10
	b.Parent = parent
	corner(b, 8)

	b.Activated:Connect(function()
		callback(b)
	end)

	return b
end

