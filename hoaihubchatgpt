--======================== DRAG ========================--

do
    local dragging = false
    local dragStart
    local startPos

    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--======================== ESP ========================--

local function clearESP()
    for model, data in pairs(State.ESPObjects) do
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        State.ESPObjects[model] = nil
    end
end

local function addESP(model)
    if not model or model == getCharacter(LocalPlayer) then return end
    if State.ESPObjects[model] then return end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local part = getTargetPart(model)

    if not humanoid or not part then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "hoaihub_ESP"
    highlight.FillColor = Color3.fromRGB(150, 70, 255)
    highlight.OutlineColor = Color3.fromRGB(235, 220, 255)
    highlight.FillTransparency = 0.75
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = model
    highlight.Parent = model

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "hoaihub_Info"
    billboard.Size = UDim2.fromOffset(180, 42)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = part
    billboard.Parent = model

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(235, 220, 255)
    label.TextStrokeTransparency = 0.4
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Parent = billboard

    State.ESPObjects[model] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
    }
end

local function scanESP()
    if not State.ESP then
        clearESP()
        return
    end

    -- Player ESP
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            addESP(player.Character)
        end
    end

    -- NPC ESP: models containing a Humanoid
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model")
            and obj ~= getCharacter(LocalPlayer)
            and obj:FindFirstChildOfClass("Humanoid")
            and getTargetPart(obj) then
            addESP(obj)
        end
    end

    for model, data in pairs(State.ESPObjects) do
        if not model.Parent then
            if data.highlight then data.highlight:Destroy() end
            if data.billboard then data.billboard:Destroy() end
            State.ESPObjects[model] = nil
        else
            local part = getTargetPart(model)
            local hum = model:FindFirstChildOfClass("Humanoid")

            if part and hum then
                local distance = (Camera.CFrame.Position - part.Position).Magnitude
                local name = model.Name

                if distance <= CONFIG.ESPMaxDistance then
                    data.billboard.Enabled = true
                    data.highlight.Enabled = true
                    data.label.Text = string.format(
                        "%s\n%d studs | HP %d",
                        name,
                        math.floor(distance),
                        math.max(0, math.floor(hum.Health))
                    )
                else
                    data.billboard.Enabled = false
                    data.highlight.Enabled = false
                end
            end
        end
    end
end

