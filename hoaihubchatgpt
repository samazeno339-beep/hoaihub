--======================== MOVEMENT LOOP ========================--

RunService.Heartbeat:Connect(function()
    local character = getCharacter(LocalPlayer)
    local humanoid = getHumanoid(LocalPlayer)
    local root = getRoot(LocalPlayer)

    if humanoid then
        if State.Speed then
            humanoid.WalkSpeed = State.SpeedValue
        else
            humanoid.WalkSpeed = CONFIG.DefaultSpeed
        end

        if State.Jump then
            if humanoid.UseJumpPower then
                humanoid.JumpPower = State.JumpValue
            else
                humanoid.JumpHeight = State.JumpValue
            end
        else
            if humanoid.UseJumpPower then
                humanoid.JumpPower = CONFIG.DefaultJump
            else
                humanoid.JumpHeight = 7.2
            end
        end
    end

    if State.Fly and root and humanoid then
        local move = humanoid.MoveDirection
        local vertical = 0

        if State.FlyUp then
            vertical = 1
        elseif State.FlyDown then
            vertical = -1
        end

        local velocity = Vector3.new(
            move.X * State.FlySpeed,
            vertical * State.FlySpeed,
            move.Z * State.FlySpeed
        )

        root.AssemblyLinearVelocity = velocity
    end
end)

--======================== AIM LOOP ========================--

RunService.RenderStepped:Connect(function()
    if not State.Aim then return end

    local target = getBestAimTarget()
    if not target then return end

    local targetCFrame = CFrame.lookAt(
        Camera.CFrame.Position,
        target.Position
    )

    Camera.CFrame = Camera.CFrame:Lerp(
        targetCFrame,
        clamp(State.AimSmoothness, 0.01, 1)
    )
end)

