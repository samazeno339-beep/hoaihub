local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function stroke(parent, thickness)
	local s = Instance.new("UIStroke")
	s.Color = Color3.fromRGB(150, 70, 255)
	s.Thickness = thickness
	s.Transparency = 0.15
	s.Parent = parent
	return s
end

local function createLabel(parent, text, height)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, -8, 0, height or 32)
	l.BackgroundColor3 = Color3.fromRGB(25, 23, 33)
	l.Text = text
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.Gotham
	l.TextSize = 11
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextWrapped = true
	l.Parent = parent
	corner(l, 9)
	return l
end

local function createToggle(parent, text, default, callback)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -8, 0, 38)
	b.BackgroundColor3 = Color3.fromRGB(31, 28, 40)
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.Parent = parent
	corner(b, 9)

	local on = default and true or false
	local function update()
		b.Text = text .. (on and " [ON]" or " [OFF]")
		b.BackgroundColor3 = on and Color3.fromRGB(92, 45, 150) or Color3.fromRGB(31, 28, 40)
	end

	update()

	b.Activated:Connect(function()
		on = not on
		update()
		if callback then
			callback(on)
		end
	end)

	return b
end

local function createNumberBox(parent, placeholder, value, callback)
	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -8, 0, 38)
	box.BackgroundColor3 = Color3.fromRGB(31, 28, 40)
	box.Text = tostring(value)
	box.PlaceholderText = placeholder
	box.TextColor3 = Color3.new(1, 1, 1)
	box.Font = Enum.Font.Gotham
	box.TextSize = 11
	box.ClearTextOnFocus = false
	box.Parent = parent
	corner(box, 9)

	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			callback(n)
		else
			box.Text = tostring(value)
		end
	end)

	return box
end

