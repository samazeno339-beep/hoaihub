local function button(parent, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -8, 0, 38)
    b.BackgroundColor3 = Color3.fromRGB(31, 28, 40)
    b.Text = text .. " [OFF]"
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.Parent = parent
    corner(b, 9)

    local on = false
    b.Activated:Connect(function()
        on = not on
        b.Text = text .. (on and " [ON]" or " [OFF]")
        b.BackgroundColor3 = on
            and Color3.fromRGB(92, 45, 150)
            or Color3.fromRGB(31, 28, 40)
        callback(on)
    end)
    return b
end

local function numberBox(parent, titleText, value, callback)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -8, 0, 38)
    box.BackgroundColor3 = Color3.fromRGB(31, 28, 40)
    box.Text = tostring(value)
    box.PlaceholderText = titleText
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Font = Enum.Font.Gotham
    box.TextSize = 11
    box.ClearTextOnFocus = false
    box.Parent = parent
    corner(box, 9)

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            callback(n)
        else
            box.Text = tostring(value)
        end
    end)
    return box
end

