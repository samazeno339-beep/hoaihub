Players.PlayerRemoving:Connect(function(plr)
	if selectedPlayer == plr then
		selectedPlayer = nil
		selectedLabel.Text = "Selected: NONE"
		updateTpButton()
	end
	removeESP(plr)
	refreshPlayers()
end)

