local frames = 0
local last = os.clock()

RunService.RenderStepped:Connect(function()
	local character = H.GetCharacter()
	local humanoid = H.GetHumanoid()
	local root = H.GetRoot()
	local cam = workspace.CurrentCamera

	if not humanoid or not root then
		return
	end

	if H.Settings.Speed then
		humanoid.WalkSpeed = H.Settings.WalkSpeed
	else
		humanoid.WalkSpeed = 16
	end

	humanoid.UseJumpPower = true
	if H.Settings.Jump then
		humanoid.JumpPower = H.Settings.JumpPower
	else
		humanoid.JumpPower = 50
	end

	if H.Settings.NoClip then
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = false
			end
		end
	else
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				obj.CanCollide = true
			end
		end
	end

	if H.Settings.ShiftLock then
		humanoid.AutoRotate = false
		humanoid.CameraOffset = Vector3.new(1.75, 0, 0)

		if cam then
			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				flat = flat.Unit
				local target = CFrame.lookAt(root.Position, root.Position + flat)
				root.CFrame = root.CFrame:Lerp(target, 0.22)
			end
		end
	else
		humanoid.AutoRotate = true
		humanoid.CameraOffset = Vector3.zero
	end

	if H.Settings.Fly then
		flyUp.Visible = true
		flyDown.Visible = true

		humanoid.PlatformStand = true
		humanoid.AutoRotate = false

		local velocity = root:FindFirstChild("HoaiFlyVelocity")
		if not velocity then
			velocity = Instance.new("BodyVelocity")
			velocity.Name = "HoaiFlyVelocity"
			velocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			velocity.P = 15000
			velocity.Parent = root
		end

		local gyro = root:FindFirstChild("HoaiFlyGyro")
		if not gyro then
			gyro = Instance.new("BodyGyro")
			gyro.Name = "HoaiFlyGyro"
			gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			gyro.P = 20000
			gyro.Parent = root
		end

		local direction = humanoid.MoveDirection * H.Settings.FlySpeed
		local vertical = 0

		if upHeld or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			vertical += H.Settings.FlySpeed
		end

		if downHeld or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			vertical -= H.Settings.FlySpeed
		end

		velocity.Velocity = Vector3.new(direction.X, vertical, direction.Z)

		if cam then
			gyro.CFrame = CFrame.lookAt(root.Position, root.Position + cam.CFrame.LookVector)
		end
	else
		flyUp.Visible = false
		flyDown.Visible = false
		humanoid.PlatformStand = false

		local velocity = root:FindFirstChild("HoaiFlyVelocity")
		local gyro = root:FindFirstChild("HoaiFlyGyro")
		if velocity then velocity:Destroy() end
		if gyro then gyro:Destroy() end
	end

	refreshOptimizeState()
	refreshStatus()
end)

RunService.RenderStepped:Connect(function()
	frames += 1
	local now = os.clock()
	if now - last >= 1 then
		local fps = frames / (now - last)
		frames = 0
		last = now

		local ping = "--"
		local ok, value = pcall(function()
			return player:GetNetworkPing() * 1000
		end)
		if ok and typeof(value) == "number" then
			ping = string.format("%.0f", value)
		end

		H.FPSLabel.Text = string.format("FPS: %.0f | Ping: %s ms", fps, ping)
	end
end)

