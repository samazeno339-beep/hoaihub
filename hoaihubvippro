local savedEffects = {}
local savedLighting = {}
local optimizeApplied = false

local function rememberAndDisable(obj, backupTable)
	if backupTable[obj] == nil then
		backupTable[obj] = obj.Enabled
	end
	obj.Enabled = false
end

local function applyOptimize()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then
			rememberAndDisable(obj, savedEffects)
		end
	end

	for _, obj in ipairs(Lighting:GetDescendants()) do
		if obj:IsA("PostEffect") then
			if savedLighting[obj] == nil then
				savedLighting[obj] = obj.Enabled
			end
			obj.Enabled = false
		end
	end
end

local function restoreOptimize()
	for obj, enabled in pairs(savedEffects) do
		if obj and obj.Parent then
			obj.Enabled = enabled
		end
	end

	for obj, enabled in pairs(savedLighting) do
		if obj and obj.Parent then
			obj.Enabled = enabled
		end
	end

	table.clear(savedEffects)
	table.clear(savedLighting)
end

local function refreshOptimizeState()
	local shouldApply = H.Settings.RemoveEffects or H.Settings.FixLag
	if shouldApply and not optimizeApplied then
		applyOptimize()
		optimizeApplied = true
	elseif not shouldApply and optimizeApplied then
		restoreOptimize()
		optimizeApplied = false
	end
end

