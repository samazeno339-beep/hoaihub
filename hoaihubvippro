-- A I M
--==================================================

local aimEnabled = false
local currentAimTarget = nil
local toolConnections = {}

local function disconnectToolConnections()
	for tool, conn in pairs(toolConnections) do
		if conn and conn.Disconnect then
			pcall(function()
				conn:Disconnect()
			end)
		end
		toolConnections[tool] = nil
	end
end

local function findNearestPlayer()
	local myRoot = getRoot()
	if not myRoot then
		return nil, nil, math.huge
	end

	local nearestPlayer
	local nearestRoot
	local nearestDistance = Settings.AimRange

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			local char = targetPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				local distance = (myRoot.Position - root.Position).Magnitude
				if distance < nearestDistance then
					nearestDistance = distance
					nearestPlayer = targetPlayer
					nearestRoot = root
				end
			end
		end
	end

	return nearestPlayer, nearestRoot, nearestDistance
end

local function updateAimTarget()
	local targetPlayer, targetRoot, distance = findNearestPlayer()
	currentAimTarget = targetPlayer

	if targetPlayer and targetRoot then
		aimNowLabel.Text = string.format(
			"Aim Target: %s | %.0f studs",
			targetPlayer.DisplayName,
			distance
		)
	else
		aimNowLabel.Text = "Aim Target: NONE"
	end

	return targetPlayer, targetRoot, distance
end

local function hookTool(tool)
	if toolConnections[tool] or not tool:IsA("Tool") then
		return
	end

	toolConnections[tool] = tool.Activated:Connect(function()
		if not Settings.Aim then
			return
		end

		local targetPlayer, targetRoot = findNearestPlayer()
		if targetPlayer and targetRoot then
			local camera = workspace.CurrentCamera
			if camera then
				camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetRoot.Position)
			end
			currentAimTarget = targetPlayer
		end
	end)

	tool.AncestryChanged:Connect(function(_, parent)
		if not parent then
			if toolConnections[tool] then
				pcall(function()
					toolConnections[tool]:Disconnect()
				end)
			end
			toolConnections[tool] = nil
		end
	end)
end

local function bindCharacterTools(character)
	disconnectToolConnections()

	for _, child in ipairs(character:GetChildren()) do
		hookTool(child)
	end

	character.ChildAdded:Connect(function(child)
		hookTool(child)
	end)
end

local function onCharacterAdded(character)
	bindCharacterTools(character)
	task.defer(function()
		refreshPlayerList()
		if Settings.PlayerESP then
			ensurePlayerESP(player)
		end
	end)
end

if player.Character then
	onCharacterAdded(player.Character)
end

player.CharacterAdded:Connect(onCharacterAdded)

_G.HoaiHubGetAimTarget = function()
	if not Settings.Aim then
		return nil
	end

	local targetPlayer, targetRoot, distance = findNearestPlayer()
	if not targetPlayer or not targetRoot then
		return nil
	end

	return {
		Player = targetPlayer,
		Character = targetPlayer.Character,
		Root = targetRoot,
		Position = targetRoot.Position,
		Distance = distance,
	}
end

--==================================================
-- OPTIMIZE / FIX LAG
--==================================================

local savedEffects = {}
local savedLighting = {}
local optimizeApplied = false

local function rememberAndDisable(obj, backupTable)
	if backupTable[obj] == nil then
		backupTable[obj] = obj.Enabled
	end
	obj.Enabled = false
end

local function applyOptimize()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ParticleEmitter")
			or obj:IsA("Trail")
			or obj:IsA("Beam")
			or obj:IsA("Smoke")
			or obj:IsA("Fire")
			or obj:IsA("Sparkles") then
			rememberAndDisable(obj, savedEffects)
		end
	end

	for _, obj in ipairs(Lighting:GetDescendants()) do
		if obj:IsA("PostEffect") then
			if savedLighting[obj] == nil then
				savedLighting[obj] = obj.Enabled
