--==================================================
-- Runtime admin/test movement
--==================================================

local bodyVelocity

local function getCharacter()
    return player.Character
end

local function getRoot()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildOfClass("Humanoid")
end

RunService.Heartbeat:Connect(function()
    local character = getCharacter()
    local humanoid = getHumanoid()
    local root = getRoot()

    if humanoid then
        humanoid.WalkSpeed = Settings.Speed and Settings.WalkSpeed or 16
        humanoid.UseJumpPower = true
        humanoid.JumpPower = Settings.Jump and Settings.JumpPower or 50
    end

    if Settings.NoClip and character then
        for _, obj in ipairs(character:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.CanCollide = false
            end
        end
    end

    if Settings.Fly and root then
        if not bodyVelocity or bodyVelocity.Parent ~= root then
            if bodyVelocity then bodyVelocity:Destroy() end
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bodyVelocity.Parent = root
        end

        local camera = workspace.CurrentCamera
        local direction = Vector3.zero

        if camera then
            local move = humanoid and humanoid.MoveDirection or Vector3.zero
            direction = move
        end

        local vertical = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical += 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical -= 1 end

        bodyVelocity.Velocity =
            direction * Settings.FlySpeed
            + Vector3.new(0, vertical * Settings.FlySpeed, 0)
    elseif bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
end)

