local playerESP = {}

local function removePlayerESP(targetPlayer)
	local data = playerESP[targetPlayer]
	if not data then return end

	if data.Highlight then data.Highlight:Destroy() end
	if data.Billboard then data.Billboard:Destroy() end
	playerESP[targetPlayer] = nil
end

local function ensurePlayerESP(targetPlayer)
	if not Settings.PlayerESP then return end
	if targetPlayer == player then return end

	local character = targetPlayer.Character
	if not character then return end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end

	local existing = playerESP[targetPlayer]
	if not existing then
		local highlight = Instance.new("Highlight")
		highlight.Name = "HoaiHubPlayerESP"
		highlight.Adornee = character
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = 0.72
		highlight.OutlineTransparency = 0
		highlight.Parent = character

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "HoaiHubPlayerInfo"
		billboard.Adornee = root
		billboard.Size = UDim2.fromOffset(180, 42)
		billboard.StudsOffset = Vector3.new(0, 3.2, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = character

		local text = Instance.new("TextLabel")
		text.Name = "Info"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextStrokeTransparency = 0.25
		text.Font = Enum.Font.GothamBold
		text.TextSize = 11
		text.TextWrapped = true
		text.Parent = billboard

		playerESP[targetPlayer] = {
			Highlight = highlight,
			Billboard = billboard,
			Text = text,
		}
	else
		existing.Highlight.Adornee = character
		existing.Billboard.Adornee = root
	end
end

local function clearAllPlayerESP()
	for targetPlayer in pairs(playerESP) do
		removePlayerESP(targetPlayer)
	end
end

