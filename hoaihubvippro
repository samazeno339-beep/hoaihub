function H.Label(parent,text,height)

	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1,-8,0,height or 32)
	l.BackgroundColor3 = Color3.fromRGB(25,23,33)
	l.Text = text
	l.TextColor3 = Color3.fromRGB(240,240,245)
	l.Font = Enum.Font.Gotham
	l.TextSize = 10
	l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent

	corner(l,8)

	return l
end

function H.Toggle(parent,text,initial,callback)

	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-8,0,34)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 10
	b.TextColor3 = Color3.new(1,1,1)
	b.Parent = parent

	corner(b,8)

	local state = initial

	local function update()
		b.Text = text .. (state and "  [ON]" or "  [OFF]")

		b.BackgroundColor3 =
			state
			and Color3.fromRGB(90,44,148)
			or Color3.fromRGB(31,28,40)
	end

	update()

	b.Activated:Connect(function()
		state = not state
		update()
		callback(state)
	end)

	return b
end

function H.NumberBox(parent,text,value,min,max,callback)

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1,-8,0,34)
	box.BackgroundColor3 = Color3.fromRGB(31,28,40)
	box.Text = tostring(value)
	box.PlaceholderText = text
	box.TextColor3 = Color3.new(1,1,1)
	box.Font = Enum.Font.Gotham
	box.TextSize = 10
	box.ClearTextOnFocus = false
	box.Parent = parent

	corner(box,8)

	box.FocusLost:Connect(function()

		local n = tonumber(box.Text)

		if n then
			n = math.clamp(n,min,max)
			box.Text = tostring(n)
			callback(n)
		else
			box.Text = tostring(value)
		end

	end)

	return box
end

function H.Button(parent,text,callback)

	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1,-8,0,34)
	b.BackgroundColor3 = Color3.fromRGB(31,28,40)
	b.Text = text
	b.TextColor3 = Color3.new(1,1,1)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 10
	b.Parent = parent

	corner(b,8)

	b.Activated:Connect(function()
		callback(b)
	end)

	return b
end

